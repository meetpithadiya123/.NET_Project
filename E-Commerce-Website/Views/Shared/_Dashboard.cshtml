<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - E-Commerce Website</title>

    <link rel="stylesheet" href="~/css/style.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>

    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

            <div class="brand">
                <span class="brand-text">
                    Dashboard
                </span>
            </div>

            <nav class="nav">

                <a href="@Url.Action("Index", "Admin")"
                   class="nav-item">
                    <span class="icon">
                        <i class="fas fa-home"></i>
                    </span>
                    <span class="nav-text">
                        Home
                    </span>
                </a>

                <a href="@Url.Action("Profile", "Admin")"
                   class="nav-item">
                    <span class="icon">
                        <i class="fas fa-user-shield"></i>
                    </span>
                    <span class="nav-text">
                        Profile
                    </span>
                </a>

                <a href="@Url.Action("fetchCustomer", "Admin")" class="nav-item">
                    <span class="icon">
                        <i class="fas fa-users"></i>
                    </span>
                    <span class="nav-text">Customer</span>
                </a>

                <a href="@Url.Action("fetchCategory", "Admin")" class="nav-item">
                    <span class="icon">
                        <i class="fas fa-list"></i>
                    </span>
                    <span class="nav-text">Category</span>
                </a>

                <a href="@Url.Action("fetchProduct", "Admin")"
                   class="nav-item">
                    <span class="icon">
                        <i class="fas fa-box"></i>
                    </span>
                    <span class="nav-text">
                        Products
                    </span>
                </a>

                <a href="@Url.Action("fetchCart", "Admin")"
                   class="nav-item">
                    <span class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </span>
                    <span class="nav-text">
                        Cart & Orders
                    </span>
                </a>

                <a href="@Url.Action("fetchfeedback", "Admin")"
                   class="nav-item">
                    <span class="icon">
                        <i class="fas fa-comments"></i>
                    </span>
                    <span class="nav-text">
                        Feedback
                    </span>
                </a>

                <a href="@Url.Action("Index", "Customer")" target="_blank"
                   class="nav-item" style="margin-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 12px;">
                    <span class="icon">
                        <i class="fas fa-external-link-alt"></i>
                    </span>
                    <span class="nav-text">
                        View Store
                    </span>
                </a>

            </nav>

        </aside>


        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">

                    <span class="topbar-title">
                        My shopping
                    </span>

                    <button type="button"
                            id="menuButton"
                            class="menu-button">

                        ☰

                    </button>

                </div>


                <div class="topbar-right">

                    <div class="dropdown">

                        <button type="button"
                                class="account-button">

                            ♟

                        </button>

                        <div class="dropdown-menu">

                            <a class="dropdown-item"
                               href="@Url.Action("Profile", "Admin")">

                                Profile

                            </a>

                            <a class="dropdown-item"
                               href="@Url.Action("Logout", "Admin")">

                                Logout

                            </a>

                        </div>

                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <section class="content">

                @RenderBody()

            </section>

        </main>

    </div>


    <script src="~/js/scripts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>