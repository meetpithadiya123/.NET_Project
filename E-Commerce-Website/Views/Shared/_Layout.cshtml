@using Microsoft.AspNetCore.Http
@{
    var sessionCustomer = Context.Session.GetString("customerSession");
    var sessionCustomerName = Context.Session.GetString("customerName");
    bool isUserLoggedIn = !string.IsNullOrEmpty(sessionCustomer);
    string userDisplayName = !string.IsNullOrEmpty(sessionCustomerName) ? sessionCustomerName : "Customer";
    string userAvatarInitial = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Molla — Gaming & Electronics</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/website/style.css" />
    <style>
        /* Top Bar Announcement User Style */
        .topbar-user-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #cbd5e1;
            font-size: 0.8rem;
        }
        .topbar-logout-link {
            color: #fca5a5 !important;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            transition: color 0.2s;
        }
        .topbar-logout-link:hover {
            color: #ef4444 !important;
            text-decoration: underline !important;
        }

        /* Main Header User Pill & Dropdown */
        .user-profile-widget {
            position: relative;
            display: inline-block;
        }

        .user-pill-button {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 14px 4px 5px;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 50px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
        }

        .user-pill-button:hover {
            background: #f8fafc;
            border-color: #6366f1;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.15);
            transform: translateY(-1px);
        }

        .user-pill-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(99, 102, 241, 0.4);
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .user-pill-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            text-align: left;
        }

        .user-pill-greeting {
            font-size: 0.65rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .user-pill-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: #0f172a;
            max-width: 110px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-pill-caret {
            font-size: 0.68rem;
            color: #94a3b8;
            margin-left: 2px;
            transition: transform 0.2s ease;
        }

        .user-profile-widget:hover .user-pill-caret {
            transform: rotate(180deg);
            color: #6366f1;
        }

        /* Floating Dropdown */
        .user-flyout-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 230px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 14px 35px -5px rgba(15, 23, 42, 0.15), 0 0 0 1px rgba(0,0,0,0.03);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1000;
            overflow: hidden;
        }

        .user-profile-widget:hover .user-flyout-menu,
        .user-profile-widget:focus-within .user-flyout-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .user-menu-header {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-menu-header-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-menu-header-details {
            overflow: hidden;
        }

        .user-menu-header-name {
            font-size: 0.92rem;
            font-weight: 700;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        .user-menu-header-status {
            font-size: 0.72rem;
            font-weight: 600;
            color: #10b981;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .user-menu-body {
            padding: 8px;
        }

        .user-menu-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #334155;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.15s ease;
        }

        .user-menu-link i {
            font-size: 0.95rem;
            color: #64748b;
            width: 18px;
            text-align: center;
            transition: color 0.15s;
        }

        .user-menu-link:hover {
            background-color: #f1f5f9;
            color: #4f46e5;
        }

        .user-menu-link:hover i {
            color: #4f46e5;
        }

        .user-menu-divider {
            height: 1px;
            background-color: #f1f5f9;
            margin: 6px 0;
        }

        .user-menu-link.logout-link {
            color: #ef4444;
        }

        .user-menu-link.logout-link i {
            color: #ef4444;
        }

        .user-menu-link.logout-link:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }
    </style>
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement">
        <span><i class="fas fa-phone-alt"></i> Support: +0123 456 789</span>
        <div class="announcement-right" style="display: flex; align-items: center; gap: 10px;">
            @if (isUserLoggedIn)
            {
                <span class="topbar-user-badge">
                    <i class="fas fa-circle-user" style="color: #38bdf8;"></i> Welcome, <strong style="color: #ffffff;">@userDisplayName</strong>
                </span>
                <span style="color: #475569;">|</span>
                <a href="@Url.Action("customerLogout", "customer")" class="topbar-logout-link" title="Logout">
                    <i class="fas fa-arrow-right-from-bracket"></i> Logout
                </a>
            }
            else
            {
                <a href="@Url.Action("customerLogin", "customer")" style="text-decoration: none;"><i class="fas fa-lock"></i> Sign In / Register</a>
                <span style="color: #475569;">|</span>
                <a href="@Url.Action("Login", "Admin")" style="text-decoration: none;"><i class="fas fa-shield-halved"></i> Admin Panel</a>
            }
        </div>
    </div>

    <!-- Header Section (Brand, Search, Account, Wishlist, Cart) -->
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="@Url.Action("Index", "customer")">
                <span class="brand-mark"><i class="fas fa-cubes"></i></span>
                <span>Molla</span>
            </a>

            <div class="search-wrap">
                <span class="search-icon"><i class="fas fa-search"></i></span>
                <input id="searchInput" type="search" placeholder="Search gaming gear, consoles..." autocomplete="off" />
                <button class="search-clear" id="clearSearch" aria-label="Clear search">&times;</button>
            </div>

            <div class="header-actions">
                @if (isUserLoggedIn)
                {
                    <!-- Logged-in User Profile Dropdown Widget -->
                    <div class="user-profile-widget">
                        <a href="@Url.Action("customerProfile", "customer")" class="user-pill-button" aria-label="Account Profile">
                            <span class="user-pill-avatar">@userAvatarInitial</span>
                            <div class="user-pill-text">
                                <span class="user-pill-greeting">Hello,</span>
                                <span class="user-pill-name">@userDisplayName</span>
                            </div>
                            <i class="fas fa-chevron-down user-pill-caret"></i>
                        </a>

                        <div class="user-flyout-menu">
                            <div class="user-menu-header">
                                <span class="user-menu-header-avatar">@userAvatarInitial</span>
                                <div class="user-menu-header-details">
                                    <strong class="user-menu-header-name">@userDisplayName</strong>
                                    <span class="user-menu-header-status">
                                        <i class="fas fa-circle" style="font-size: 0.5rem;"></i> Signed In
                                    </span>
                                </div>
                            </div>
                            <div class="user-menu-body">
                                <a href="@Url.Action("customerProfile", "customer")" class="user-menu-link">
                                    <i class="fas fa-user"></i> My Profile
                                </a>
                                <a href="@Url.Action("fetchCart", "customer")" class="user-menu-link">
                                    <i class="fas fa-shopping-bag"></i> My Cart
                                </a>
                                <div class="user-menu-divider"></div>
                                <a href="@Url.Action("customerLogout", "customer")" class="user-menu-link logout-link">
                                    <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("customerLogin", "customer")" class="header-action" aria-label="Account" style="text-decoration: none;">
                        <i class="fas fa-user"></i>
                        <span>Sign In</span>
                    </a>
                }

                <a href="@Url.Action("fetchCart", "customer")" class="header-action count-action" id="cartBtn" aria-label="Cart" style="text-decoration: none;">
                    <i class="fas fa-shopping-bag"></i>
                    <span>Cart</span>
                    <b id="cartCount">0</b>
                </a>
            </div>
        </div>

        <nav class="main-nav">
            <button class="mobile-menu" id="mobileMenu"><i class="fas fa-bars"></i></button>
            <a href="@Url.Action("Index", "customer")#top">HOME</a>
            <a href="@Url.Action("allProduct", "Customer")">PRODUCTS</a>
            <a href="@Url.Action("Index", "customer")#categories">CATEGORIES</a>
            <a href="@Url.Action("Index", "customer")#support">ABOUT US</a>
            <a href="@Url.Action("feedback", "customer")">CONTACT US</a>
        </nav>
    </header>

    <!-- Page Body Rendered Here -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="brand" href="#top"><span class="brand-mark"><i class="fas fa-cubes"></i></span> Molla</a>
                <p style="color:#64748b; font-size:0.85rem; margin-top:8px;">Modern gaming gear for players who want more.</p>
            </div>
            <div>
                <h4>Shop</h4>
                <a href="#products">Playstation</a>
                <a href="#products">XBOX</a>
                <a href="#products">Nintendo</a>
            </div>
            <div>
                <h4>Help</h4>
                <a href="#support">Shipping</a>
                <a href="#support">Returns</a>
                <a href="#support">Support</a>
            </div>
            <div>
                <h4>Newsletter</h4>
                <div class="newsletter">
                    <input id="emailInput" placeholder="Your email address" />
                    <button id="emailBtn">&rarr;</button>
                </div>
            </div>
        </div>
        <div class="copyright">&copy; 2026 Molla Inc. All rights reserved.</div>
    </footer>

    <!-- Dynamic Cart & Toast Elements -->
    <div class="toast" id="toast"></div>
    <div class="mini-cart" id="miniCart">
        <div class="mini-cart-header">
            <strong>Your Cart</strong>
            <button id="closeCart">&times;</button>
        </div>
        <p id="cartItemsText" style="color:#64748b; font-size:0.9rem;">Your cart is empty.</p>
        <div class="cart-total" id="cartTotal" style="margin-top:auto; font-weight:700; font-size:1.1rem;"></div>
    </div>

    <script src="~/website/script.js"></script>


    <!-- Toast Notification Pop-up -->
    <div id="cartToast" style="display: none; position: fixed; bottom: 30px; right: 30px; background-color: #10b981; color: #ffffff; padding: 14px 24px; border-radius: 10px; font-weight: 600; font-size: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 9999; align-items: center; gap: 10px; transition: all 0.3s ease;">
        <i class="fas fa-check-circle" style="font-size: 18px;"></i>
        <span id="cartToastMsg">Product successfully added to cart!</span>
    </div>

    <script>
            function addToCartAjax(productId) {
                fetch('/Customer/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'prod_id=' + encodeURIComponent(productId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success toast pop-up
                        const toast = document.getElementById('cartToast');
                        const toastMsg = document.getElementById('cartToastMsg');
                        toastMsg.innerText = data.message;
                        toast.style.display = 'flex';

                        // Increment cart badge counter if present
                        const cartBadge = document.getElementById('cartCount');
                        if (cartBadge) {
                            let currentCount = parseInt(cartBadge.innerText) || 0;
                            cartBadge.innerText = currentCount + 1;
                        }

                        // Hide after 3 seconds
                        setTimeout(() => {
                            toast.style.display = 'none';
                        }, 3000);
                    } else if (data.redirect) {
                        // If not logged in, send to login
                        window.location.href = data.redirect;
                    }
                })
                .catch(err => console.error('Error adding to cart:', err));
            }
    </script>
</body>
</html>