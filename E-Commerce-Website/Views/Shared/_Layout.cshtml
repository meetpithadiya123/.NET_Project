@using Microsoft.AspNetCore.Http
@{
    var sessionCustomer = Context.Session.GetString("customerSession");
    var sessionCustomerName = Context.Session.GetString("customerName");
    bool isUserLoggedIn = !string.IsNullOrEmpty(sessionCustomer);
    string userDisplayName = !string.IsNullOrEmpty(sessionCustomerName) ? sessionCustomerName : "Customer";
    string userAvatarInitial = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UrbanCart — Premium Electronics &amp; Tech</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/website/style.css" />
    <style>
        /* Top Bar Announcement User Style */
        .topbar-user-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #cbd5e1;
            font-size: 0.8rem;
        }
        .topbar-logout-link {
            color: #fca5a5 !important;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            transition: color 0.2s;
        }
        .topbar-logout-link:hover {
            color: #ef4444 !important;
            text-decoration: underline !important;
        }

        /* Main Header User Pill & Dropdown */
        .user-profile-widget {
            position: relative;
            display: inline-block;
        }

        .user-pill-button {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 14px 4px 5px;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 50px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
        }

        .user-pill-button:hover {
            background: #f8fafc;
            border-color: #6366f1;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.15);
            transform: translateY(-1px);
        }

        .user-pill-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(99, 102, 241, 0.4);
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .user-pill-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            text-align: left;
        }

        .user-pill-greeting {
            font-size: 0.65rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .user-pill-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: #0f172a;
            max-width: 110px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-pill-caret {
            font-size: 0.68rem;
            color: #94a3b8;
            margin-left: 2px;
            transition: transform 0.2s ease;
        }

        .user-profile-widget:hover .user-pill-caret {
            transform: rotate(180deg);
            color: #6366f1;
        }

        /* Floating Dropdown */
        .user-flyout-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 230px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 14px 35px -5px rgba(15, 23, 42, 0.15), 0 0 0 1px rgba(0,0,0,0.03);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1000;
            overflow: hidden;
        }

        .user-profile-widget:hover .user-flyout-menu,
        .user-profile-widget:focus-within .user-flyout-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .user-menu-header {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-menu-header-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-menu-header-details {
            overflow: hidden;
        }

        .user-menu-header-name {
            font-size: 0.92rem;
            font-weight: 700;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        .user-menu-header-status {
            font-size: 0.72rem;
            font-weight: 600;
            color: #10b981;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .user-menu-body {
            padding: 8px;
        }

        .user-menu-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #334155;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.15s ease;
        }

        .user-menu-link i {
            font-size: 0.95rem;
            color: #64748b;
            width: 18px;
            text-align: center;
            transition: color 0.15s;
        }

        .user-menu-link:hover {
            background-color: #f1f5f9;
            color: #4f46e5;
        }

        .user-menu-link:hover i {
            color: #4f46e5;
        }

        .user-menu-divider {
            height: 1px;
            background-color: #f1f5f9;
            margin: 6px 0;
        }

        .user-menu-link.logout-link {
            color: #ef4444;
        }

        .user-menu-link.logout-link i {
            color: #ef4444;
        }

        .user-menu-link.logout-link:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }

        /* Search Bar & Autocomplete Enhancements */
        .search-wrap {
            position: relative;
            flex: 1;
            max-width: 520px;
        }

        .search-icon-btn {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            font-size: 0.95rem;
            cursor: pointer;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .search-icon-btn:hover {
            color: #4f46e5;
            transform: translateY(-50%) scale(1.1);
        }

        .search-wrap input#searchInput {
            width: 100%;
            padding: 10px 38px 10px 42px;
            border-radius: 50px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            font-size: 0.88rem;
            font-weight: 500;
            color: #0f172a;
            outline: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .search-wrap input#searchInput:focus {
            border-color: #6366f1;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        }

        .search-clear {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: #e2e8f0;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            font-size: 0.95rem;
            line-height: 1;
            cursor: pointer;
            transition: all 0.15s ease;
            z-index: 3;
        }

        .search-clear:hover {
            background: #cbd5e1;
            color: #0f172a;
        }

        .search-dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 16px 36px -6px rgba(15, 23, 42, 0.16), 0 0 1px rgba(0,0,0,0.1);
            z-index: 1000;
            overflow: hidden;
            display: none;
            animation: searchFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes searchFadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .search-dropdown-header {
            padding: 9px 16px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .search-item-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            text-decoration: none;
            color: #1e293b;
            transition: background 0.15s ease;
            border-bottom: 1px solid #f8fafc;
        }

        .search-item-row:hover, .search-item-row.is-active {
            background: #f1f5f9;
        }

        .search-item-thumb {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            object-fit: contain;
            padding: 2px;
            flex-shrink: 0;
        }

        .search-item-details {
            flex-grow: 1;
            min-width: 0;
        }

        .search-item-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px;
        }

        .search-item-title mark {
            background: #fef08a;
            color: #854d0e;
            padding: 0 2px;
            border-radius: 3px;
        }

        .search-item-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.74rem;
            color: #64748b;
        }

        .search-item-price {
            font-size: 0.88rem;
            font-weight: 800;
            color: #4f46e5;
            flex-shrink: 0;
        }

        .search-dropdown-footer {
            display: block;
            padding: 11px 16px;
            font-size: 0.82rem;
            font-weight: 700;
            color: #4f46e5;
            background: #faf5ff;
            text-align: center;
            text-decoration: none;
            border-top: 1px solid #f3e8ff;
            transition: background 0.15s;
        }

        .search-dropdown-footer:hover {
            background: #f3e8ff;
            color: #3730a3;
        }

        .search-no-results {
            padding: 20px 16px;
            text-align: center;
            color: #64748b;
            font-size: 0.88rem;
        }

        /* ===== Mobile Responsive – Inline Layout Styles ===== */
        @@media (max-width: 640px) {
            /* Shrink or hide the user pill text on very small screens */
            .user-pill-text {
                display: none;
            }

            .user-pill-button {
                padding: 4px 6px;
            }

            .user-pill-caret {
                display: none;
            }

            /* Search bar padding adjustment */
            .search-wrap input#searchInput {
                font-size: 0.82rem;
                padding: 9px 34px 9px 38px;
            }

            /* Flyout dropdown – full-width anchored to viewport edge */
            .user-flyout-menu {
                width: 210px;
                right: 0;
            }

            /* Topbar announcement bar text */
            .topbar-user-badge {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement">
        <span><i class="fas fa-phone-alt"></i> Support: +0123 456 789</span>
        <div class="announcement-right" style="display: flex; align-items: center; gap: 10px;">
            @if (isUserLoggedIn)
            {
                <span class="topbar-user-badge">
                    <i class="fas fa-circle-user" style="color: #38bdf8;"></i> Welcome, <strong style="color: #ffffff;">@userDisplayName</strong>
                </span>
                <span style="color: #475569;">|</span>
                <a href="@Url.Action("customerLogout", "customer")" class="topbar-logout-link" title="Logout">
                    <i class="fas fa-arrow-right-from-bracket"></i> Logout
                </a>
            }
            else
            {
                <a href="@Url.Action("customerLogin", "customer")" style="text-decoration: none;"><i class="fas fa-lock"></i> Sign In / Register</a>
                <span style="color: #475569;">|</span>
                <a href="@Url.Action("Login", "Admin")" style="text-decoration: none;"><i class="fas fa-shield-halved"></i> Admin Panel</a>
            }
        </div>
    </div>

    <!-- Header Section (Brand, Search, Account, Wishlist, Cart) -->
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="@Url.Action("Index", "customer")">
                <span class="brand-mark"><i class="fas fa-cart-shopping"></i></span>
                <span>UrbanCart</span>
            </a>

            <form id="globalSearchForm" method="get" action="@Url.Action("allProduct", "Customer")" class="search-wrap">
                <button type="submit" class="search-icon-btn" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <input id="searchInput" name="search" type="search" value="@ViewBag.SearchQuery" placeholder="Search smartphones, gaming gear, laptops..." autocomplete="off" />
                <button type="button" class="search-clear" id="clearSearch" aria-label="Clear search" style="@(string.IsNullOrEmpty(ViewBag.SearchQuery as string) ? "display: none;" : "")">&times;</button>

                <!-- Interactive Autocomplete Dropdown -->
                <div id="searchSuggestionsDropdown" class="search-dropdown-menu"></div>
            </form>

            <div class="header-actions">
                @if (isUserLoggedIn)
                {
                    <!-- Logged-in User Profile Dropdown Widget -->
                    <div class="user-profile-widget">
                        <a href="@Url.Action("customerProfile", "customer")" class="user-pill-button" aria-label="Account Profile">
                            <span class="user-pill-avatar">@userAvatarInitial</span>
                            <div class="user-pill-text">
                                <span class="user-pill-greeting">Hello,</span>
                                <span class="user-pill-name">@userDisplayName</span>
                            </div>
                            <i class="fas fa-chevron-down user-pill-caret"></i>
                        </a>

                        <div class="user-flyout-menu">
                            <div class="user-menu-header">
                                <span class="user-menu-header-avatar">@userAvatarInitial</span>
                                <div class="user-menu-header-details">
                                    <strong class="user-menu-header-name">@userDisplayName</strong>
                                    <span class="user-menu-header-status">
                                        <i class="fas fa-circle" style="font-size: 0.5rem;"></i> Signed In
                                    </span>
                                </div>
                            </div>
                            <div class="user-menu-body">
                                <a href="@Url.Action("customerProfile", "customer")" class="user-menu-link">
                                    <i class="fas fa-user"></i> My Profile
                                </a>
                                <a href="@Url.Action("fetchCart", "customer")" class="user-menu-link">
                                    <i class="fas fa-shopping-bag"></i> My Cart
                                </a>
                                <div class="user-menu-divider"></div>
                                <a href="@Url.Action("customerLogout", "customer")" class="user-menu-link logout-link">
                                    <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("customerLogin", "customer")" class="header-action" aria-label="Account" style="text-decoration: none;">
                        <i class="fas fa-user"></i>
                        <span>Sign In</span>
                    </a>
                }

                <a href="@Url.Action("fetchCart", "customer")" class="header-action count-action" id="cartBtn" aria-label="Cart" style="text-decoration: none;">
                    <i class="fas fa-shopping-bag"></i>
                    <span>Cart</span>
                    <b id="cartCount">0</b>
                </a>
            </div>
        </div>

        <nav class="main-nav">
            <button class="mobile-menu" id="mobileMenu"><i class="fas fa-bars"></i></button>
            <a href="@Url.Action("Index", "customer")#top">HOME</a>
            <a href="@Url.Action("allProduct", "Customer")">PRODUCTS</a>
            <a href="@Url.Action("allProduct", "Customer")">CATEGORIES</a>
            <a href="@Url.Action("About", "Customer")">ABOUT US</a>
            <a href="@Url.Action("feedback", "customer")">CONTACT US</a>
        </nav>
    </header>

    <!-- Page Body Rendered Here -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="brand" href="#top"><span class="brand-mark"><i class="fas fa-cart-shopping"></i></span> UrbanCart</a>
                <p style="color:#64748b; font-size:0.85rem; margin-top:8px;">Next-gen electronics, smartphones, gaming gear, and tech essentials delivered to your door.</p>
            </div>
            <div>
                <h4>Shop Categories</h4>
                <a href="@Url.Action("allProduct", "Customer")">Smartphones &amp; Tablets</a>
                <a href="@Url.Action("allProduct", "Customer")">Laptops &amp; PCs</a>
                <a href="@Url.Action("allProduct", "Customer")">Gaming &amp; Consoles</a>
                <a href="@Url.Action("allProduct", "Customer")">Audio &amp; Headphones</a>
            </div>
            <div>
                <h4>Help &amp; Info</h4>
                <a href="@Url.Action("About", "Customer")">About Us</a>
                <a href="@Url.Action("feedback", "Customer")">Customer Support</a>
                <a href="@Url.Action("fetchCart", "Customer")">View Shopping Cart</a>
                <a href="@Url.Action("customerProfile", "Customer")">My Account</a>
            </div>
            <div>
                <h4>Newsletter</h4>
                <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px;">Subscribe for exclusive hardware drops &amp; flash discounts.</p>
                <div class="newsletter">
                    <input id="emailInput" placeholder="Your email address" />
                    <button id="emailBtn">&rarr;</button>
                </div>
            </div>
        </div>
        <div class="copyright">&copy; 2026 UrbanCart Inc. All rights reserved. &bull; 100% Genuine Technology</div>
    </footer>

    <!-- Dynamic Cart & Toast Elements -->
    <div class="toast" id="toast"></div>
    <div class="mini-cart" id="miniCart">
        <div class="mini-cart-header">
            <strong>Your Cart</strong>
            <button id="closeCart">&times;</button>
        </div>
        <p id="cartItemsText" style="color:#64748b; font-size:0.9rem;">Your cart is empty.</p>
        <div class="cart-total" id="cartTotal" style="margin-top:auto; font-weight:700; font-size:1.1rem;"></div>
    </div>

    <script src="~/website/script.js"></script>


    <!-- Toast Notification Pop-up -->
    <div id="cartToast" style="display: none; position: fixed; bottom: 30px; right: 30px; background-color: #10b981; color: #ffffff; padding: 14px 24px; border-radius: 10px; font-weight: 600; font-size: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 9999; align-items: center; gap: 10px; transition: all 0.3s ease;">
        <i class="fas fa-check-circle" style="font-size: 18px;"></i>
        <span id="cartToastMsg">Product successfully added to cart!</span>
    </div>

    <script>
            function addToCartAjax(productId) {
                fetch('/Customer/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'prod_id=' + encodeURIComponent(productId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success toast pop-up
                        const toast = document.getElementById('cartToast');
                        const toastMsg = document.getElementById('cartToastMsg');
                        toastMsg.innerText = data.message;
                        toast.style.display = 'flex';

                        // Increment cart badge counter if present
                        const cartBadge = document.getElementById('cartCount');
                        if (cartBadge) {
                            let currentCount = parseInt(cartBadge.innerText) || 0;
                            cartBadge.innerText = currentCount + 1;
                        }

                        // Hide after 3 seconds
                        setTimeout(() => {
                            toast.style.display = 'none';
                        }, 3000);
                    } else if (data.redirect) {
                        // If not logged in, send to login
                        window.location.href = data.redirect;
                    }
                })
                .catch(err => console.error('Error adding to cart:', err));
            }

            /* ====================================================
               GLOBAL SEARCHBAR LOGIC (LIVE FILTER + AUTOCOMPLETE)
               ==================================================== */
            document.addEventListener('DOMContentLoaded', function () {
                const searchInput = document.getElementById('searchInput');
                const clearSearchBtn = document.getElementById('clearSearch');
                const searchForm = document.getElementById('globalSearchForm');
                const suggestionsBox = document.getElementById('searchSuggestionsDropdown');

                if (!searchInput) return;

                let debounceTimer = null;
                const isHomePage = window.location.pathname === '/' ||
                                   window.location.pathname.toLowerCase().endsWith('/customer') ||
                                   window.location.pathname.toLowerCase().endsWith('/customer/index');
                const isCatalogPage = window.location.pathname.toLowerCase().includes('/customer/allproduct');

                // Adjust form action based on page
                if (searchForm) {
                    searchForm.addEventListener('submit', function (e) {
                        const q = searchInput.value.trim();
                        if (!q) {
                            e.preventDefault();
                            return;
                        }
                        if (isHomePage) {
                            searchForm.action = '@Url.Action("Index", "Customer")';
                        } else {
                            searchForm.action = '@Url.Action("allProduct", "Customer")';
                        }
                    });
                }

                // Live Input Handler
                searchInput.addEventListener('input', function () {
                    const query = this.value.trim();

                    // Toggle clear button
                    if (clearSearchBtn) {
                        clearSearchBtn.style.display = query ? 'flex' : 'none';
                    }

                    // 1. Instant on-page card filtering if on Home or Catalog page
                    if (isHomePage) {
                        filterHomePageProducts(query);
                    } else if (isCatalogPage) {
                        filterCatalogPageProducts(query);
                    }

                    // 2. Fetch live dropdown autocomplete suggestions
                    clearTimeout(debounceTimer);
                    if (query.length >= 2) {
                        debounceTimer = setTimeout(() => {
                            fetchSuggestions(query);
                        }, 200);
                    } else {
                        hideSuggestions();
                    }
                });

                // Clear button clicked
                if (clearSearchBtn) {
                    clearSearchBtn.addEventListener('click', function () {
                        searchInput.value = '';
                        clearSearchBtn.style.display = 'none';
                        hideSuggestions();

                        if (isHomePage) {
                            filterHomePageProducts('');
                            // If page was loaded with a server search query, redirect to clean home page
                            if (window.location.search.includes('search=')) {
                                window.location.href = '@Url.Action("Index", "Customer")';
                            }
                        } else if (isCatalogPage) {
                            filterCatalogPageProducts('');
                            if (window.location.search.includes('search=')) {
                                window.location.href = '@Url.Action("allProduct", "Customer")';
                            }
                        }
                        searchInput.focus();
                    });
                }

                // Close suggestions on outside click
                document.addEventListener('click', function (e) {
                    if (searchForm && !searchForm.contains(e.target)) {
                        hideSuggestions();
                    }
                });

                // Keyboard escape to close suggestions
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        hideSuggestions();
                    }
                });

                // Fetch Suggestions AJAX
                function fetchSuggestions(query) {
                    fetch('/Customer/SearchSuggestions?query=' + encodeURIComponent(query))
                        .then(res => res.json())
                        .then(items => {
                            renderSuggestions(items, query);
                        })
                        .catch(() => hideSuggestions());
                }

                // Render Suggestions HTML
                function renderSuggestions(items, query) {
                    if (!suggestionsBox) return;

                    if (!items || items.length === 0) {
                        suggestionsBox.innerHTML = `
                            <div class="search-dropdown-header">
                                <span>Suggested Products</span>
                            </div>
                            <div class="search-no-results">
                                <i class="fas fa-search" style="color:#94a3b8; margin-right:6px;"></i>
                                No matching products for "<strong>${escapeHtml(query)}</strong>"
                            </div>
                            <a href="${isHomePage ? '@Url.Action("Index", "Customer")' : '@Url.Action("allProduct", "Customer")'}?search=${encodeURIComponent(query)}" class="search-dropdown-footer">
                                Search entire catalog for "${escapeHtml(query)}" &rarr;
                            </a>
                        `;
                        suggestionsBox.style.display = 'block';
                        return;
                    }

                    const targetAction = isHomePage ? '@Url.Action("Index", "Customer")' : '@Url.Action("allProduct", "Customer")';
                    let html = `
                        <div class="search-dropdown-header">
                            <span>Top Matches (${items.length})</span>
                            <span style="font-size:0.7rem; color:#94a3b8;">Press Enter to view all</span>
                        </div>
                    `;

                    items.forEach(p => {
                        const priceNum = parseFloat(p.price) || 0;
                        const formattedPrice = '₹' + priceNum.toLocaleString('en-IN');
                        const imgSrc = p.image ? ('/product_images/' + p.image) : '/images/placeholder.svg';

                        // Highlight match in title
                        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
                        const highlightedTitle = escapeHtml(p.name).replace(regex, '<mark>$1</mark>');

                        html += `
                            <a href="/Customer/productDetails/${p.id}" class="search-item-row">
                                <img src="${imgSrc}" alt="${escapeHtml(p.name)}" class="search-item-thumb" loading="lazy" decoding="async" />
                                <div class="search-item-details">
                                    <div class="search-item-title">${highlightedTitle}</div>
                                    <div class="search-item-meta">
                                        ${p.category ? `<span class="badge" style="background:#f1f5f9; color:#475569; font-size:0.7rem; padding:2px 6px; border-radius:4px;">${escapeHtml(p.category)}</span>` : ''}
                                        <span>Verified Brand</span>
                                    </div>
                                </div>
                                <div class="search-item-price">${formattedPrice}</div>
                            </a>
                        `;
                    });

                    html += `
                        <a href="${targetAction}?search=${encodeURIComponent(query)}" class="search-dropdown-footer">
                            View all results for "${escapeHtml(query)}" &rarr;
                        </a>
                    `;

                    suggestionsBox.innerHTML = html;
                    suggestionsBox.style.display = 'block';
                }

                function hideSuggestions() {
                    if (suggestionsBox) {
                        suggestionsBox.style.display = 'none';
                    }
                }

                // Instant In-Page Filter for Home Page
                function filterHomePageProducts(term) {
                    const cards = document.querySelectorAll('.store-card');
                    const liveBanner = document.getElementById('liveSearchBanner');
                    const noResults = document.getElementById('noLiveSearchResults');
                    const serverBanner = document.querySelector('.search-active-banner');

                    if (!cards.length) return;

                    const cleanTerm = term.toLowerCase().trim();
                    let matchCount = 0;

                    cards.forEach(card => {
                        const titleEl = card.querySelector('.store-card-title');
                        const categoryEl = card.querySelector('.brand-tag-badge');

                        const titleText = titleEl ? titleEl.textContent.toLowerCase() : '';
                        const catText = categoryEl ? categoryEl.textContent.toLowerCase() : '';

                        if (!cleanTerm || titleText.includes(cleanTerm) || catText.includes(cleanTerm)) {
                            card.style.display = '';
                            matchCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    // Manage live status banner
                    if (liveBanner) {
                        if (cleanTerm) {
                            if (serverBanner) serverBanner.style.display = 'none';
                            liveBanner.innerHTML = `
                                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; background:#eef2ff; border:1px solid #c7d2fe; border-radius:12px; padding:10px 18px;">
                                    <div style="font-weight:600; font-size:0.9rem; color:#1e1b4b; display:flex; align-items:center; gap:8px;">
                                        <i class="fas fa-magnifying-glass" style="color:#4f46e5;"></i>
                                        Found ${matchCount} product${matchCount === 1 ? '' : 's'} matching "<strong>${escapeHtml(cleanTerm)}</strong>"
                                    </div>
                                    <button type="button" onclick="document.getElementById('clearSearch').click();" style="background:#ffffff; border:1px solid #c7d2fe; color:#4338ca; border-radius:6px; padding:4px 12px; font-size:0.8rem; font-weight:700; cursor:pointer;">
                                        Reset Filter
                                    </button>
                                </div>
                            `;
                            liveBanner.style.display = 'block';
                        } else {
                            liveBanner.style.display = 'none';
                            if (serverBanner) serverBanner.style.display = 'flex';
                        }
                    }

                    if (noResults) {
                        if (cleanTerm && matchCount === 0) {
                            noResults.innerHTML = `
                                <div style="text-align:center; padding:50px 20px; color:#64748b;">
                                    <i class="fas fa-box-open fa-3x" style="color:#cbd5e1; margin-bottom:14px; display:block;"></i>
                                    <h4 style="color:#0f172a; margin-bottom:6px; font-weight:700;">No products match "${escapeHtml(cleanTerm)}"</h4>
                                    <p style="font-size:0.9rem; margin-bottom:16px;">Try checking your spelling or search for popular terms like iPhone, Sony, or PS5.</p>
                                    <button type="button" onclick="document.getElementById('clearSearch').click();" class="btn-card-cart-proper" style="margin: 0 auto; display:inline-flex;">
                                        Clear Search
                                    </button>
                                </div>
                            `;
                            noResults.style.display = 'block';
                        } else {
                            noResults.style.display = 'none';
                        }
                    }
                }

                // Instant In-Page Filter for Catalog Page
                function filterCatalogPageProducts(term) {
                    const cards = document.querySelectorAll('.catalog-card');
                    const cleanTerm = term.toLowerCase().trim();
                    let matchCount = 0;

                    cards.forEach(card => {
                        const titleEl = card.querySelector('.catalog-title');
                        const catEl = card.querySelector('.catalog-category-tag');

                        const titleText = titleEl ? titleEl.textContent.toLowerCase() : '';
                        const catText = catEl ? catEl.textContent.toLowerCase() : '';

                        if (!cleanTerm || titleText.includes(cleanTerm) || catText.includes(cleanTerm)) {
                            card.style.display = '';
                            matchCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    const countBadge = document.querySelector('.catalog-count-badge');
                    if (countBadge && cleanTerm) {
                        countBadge.innerText = `Showing ${matchCount} of ${cards.length} Products`;
                    }
                }

                function escapeHtml(text) {
                    if (!text) return '';
                    return text.replace(/[&<>"']/g, function (m) {
                        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
                    });
                }

                function escapeRegex(text) {
                    return text.replace(/[-[\]{}()*+?.,\\^$|#\s]/g, '\\$&');
                }
            });

            /* ================================================
               MOBILE NAV TOGGLE
               ================================================ */
            (function () {
                var menuBtn = document.getElementById('mobileMenu');
                var mainNav = document.querySelector('.main-nav');
                if (!menuBtn || !mainNav) return;

                menuBtn.addEventListener('click', function () {
                    var isOpen = mainNav.classList.toggle('open');
                    menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    menuBtn.innerHTML = isOpen
                        ? '<i class="fas fa-times"></i>'
                        : '<i class="fas fa-bars"></i>';
                });

                // Close nav when a link inside is clicked
                mainNav.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', function () {
                        mainNav.classList.remove('open');
                        menuBtn.innerHTML = '<i class="fas fa-bars"></i>';
                        menuBtn.setAttribute('aria-expanded', 'false');
                    });
                });

                // Close nav on outside click
                document.addEventListener('click', function (e) {
                    if (!mainNav.contains(e.target) && !menuBtn.contains(e.target)) {
                        mainNav.classList.remove('open');
                        menuBtn.innerHTML = '<i class="fas fa-bars"></i>';
                        menuBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            })();
    </script>
</body>
</html>