@model E_Commerce_Website.Models.Product

<div class="product-details-wrapper" style="max-width: 950px; margin: 30px auto; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;">
    
    <!-- Top Action / Navigation Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <a href="@Url.Action("fetchProduct", "Admin")" style="display: inline-flex; align-items: center; gap: 8px; color: #64748b; text-decoration: none; font-weight: 600; font-size: 0.95rem;">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
            <h2 style="margin: 8px 0 0 0; color: #0f172a; font-size: 1.75rem; font-weight: 700;">Product Overview</h2>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="@Url.Action("updateProduct", "Admin", new { id = Model.product_id })" 
               style="display: inline-flex; align-items: center; gap: 8px; background: #2563eb; color: #ffffff; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; box-shadow: 0 4px 12px rgba(37,99,235,0.25);">
                <i class="fas fa-pen"></i> Edit Product
            </a>
            <a href="@Url.Action("deleteProduct", "Admin", new { id = Model.product_id })" 
               onclick="return confirm('Are you sure you want to delete this product?');"
               style="display: inline-flex; align-items: center; gap: 8px; background: #fee2e2; color: #dc2626; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600;">
                <i class="fas fa-trash"></i> Delete
            </a>
        </div>
    </div>

    <!-- Main Content Container -->
    <div style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); overflow: hidden;">
        
        <div style="display: grid; grid-template-columns: 380px 1fr; min-height: 440px;">
            
            <!-- Left: Full-Bleed Product Media Section -->
            <div style="position: relative; width: 100%; height: 100%; min-height: 380px; background: #f8fafc; border-right: 1px solid #e2e8f0; overflow: hidden;">
                
                <span style="position: absolute; top: 16px; left: 16px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px); color: #ffffff; font-size: 0.75rem; font-weight: 700; padding: 5px 12px; border-radius: 20px; letter-spacing: 0.5px; z-index: 2;">
                    ID #@Model.product_id
                </span>

                @if (!string.IsNullOrEmpty(Model.product_image))
                {
                    <img src="~/product_images/@Model.product_image" 
                         alt="@Model.product_name" 
                         style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                }
                else
                {
                    <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #94a3b8;">
                        <i class="fas fa-image" style="font-size: 3.5rem; margin-bottom: 10px;"></i>
                        <span style="font-size: 0.9rem; font-weight: 500;">No photo available</span>
                    </div>
                }
            </div>

            <!-- Right: Product Information Section -->
            <div style="padding: 36px 40px; display: flex; flex-direction: column; justify-content: space-between;">
                
                <div>
                    <!-- Category Tag -->
                    <div style="margin-bottom: 14px;">
                        <span style="display: inline-flex; align-items: center; gap: 6px; background: #eff6ff; color: #2563eb; font-size: 0.8rem; font-weight: 700; padding: 5px 12px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <i class="fas fa-tag"></i>
                            @(Model.Category != null ? Model.Category.category_name : "Uncategorized")
                        </span>
                    </div>

                    <!-- Product Title -->
                    <h1 style="font-size: 1.95rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; line-height: 1.25;">
                        @Model.product_name
                    </h1>

                    <!-- Price Card -->
                    <div style="display: inline-block; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 8px 18px; border-radius: 10px; margin-bottom: 24px;">
                        <span style="font-size: 0.75rem; font-weight: 700; color: #15803d; text-transform: uppercase; display: block;">Price</span>
                        <span style="font-size: 1.65rem; font-weight: 800; color: #16a34a;">
                            ₹@Model.product_price
                        </span>
                    </div>

                    <!-- Description Block -->
                    <div>
                        <h4 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; color: #64748b; margin: 0 0 8px 0;">
                            Description
                        </h4>
                        <div style="font-size: 0.95rem; line-height: 1.65; color: #334155; background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #f1f5f9; min-height: 90px;">
                            @if (!string.IsNullOrWhiteSpace(Model.product_description))
                            {
                                @Model.product_description
                            }
                            else
                            {
                                <span style="color: #94a3b8; font-style: italic;">No detailed description provided for this product.</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Meta Info -->
                <div style="border-top: 1px solid #f1f5f9; padding-top: 16px; margin-top: 24px; display: flex; justify-content: space-between; font-size: 0.8rem; color: #94a3b8;">
                    <span>Database Record Status: <strong style="color: #10b981;">Active</strong></span>
                    <span>System ID: <strong>#@Model.product_id</strong></span>
                </div>

            </div>

        </div>

    </div>
</div>