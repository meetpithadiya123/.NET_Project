@model E_Commerce_Website.Models.Admin

@{
    ViewData["Title"] = "Profile";
}

<div class="profile-page">

    <h1 class="dashboard-title">
        My Profile
    </h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    <form method="post"
          action="@Url.Action("Profile", "Admin")"
          class="profile-form">

        <input type="hidden"
               name="admin_id"
               value="@Model.admin_id" />

        <input type="text"
               name="admin_name"
               placeholder="Enter Your Name"
               class="form-control"
               value="@Model.admin_name"
               required />

        <input type="email"
               name="admin_email"
               placeholder="Enter Your E-mail"
               class="form-control"
               value="@Model.admin_email"
               required />

        <input type="password"
               name="admin_password"
               placeholder="Enter Your Password"
               class="form-control"
               value="@Model.admin_password"
               required />

        <input type="submit"
               value="Update Profile" />

    </form>

</div>