@model List<E_Commerce_Website.Models.Cart>

@{
    ViewData["Title"] = "Cart Management";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<h1 class="dashboard-title">Cart List</h1>

<div class="row">
    <div class="col-md-12">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <table class="table table-bordered table-striped text-center mt-3">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Customer Name</th>
                    <th>Product Quantity</th>
                    <th>Status</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cart in Model)
                    {
                        <tr>
                            <td>@cart.products.product_name</td>
                            <td>@cart.customers.customer_name</td>
                            <td>@cart.product_quantity</td>
                            <td>@cart.cart_status</td>
                            <td>
                                <a href="@Url.Action("deletecart", "Admin", new { id = cart.cart_id })"
                                   onclick="return confirm('Are you sure you want to delete this cart item?');"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-muted">No cart records available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>