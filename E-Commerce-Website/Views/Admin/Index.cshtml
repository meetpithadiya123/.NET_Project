@model E_Commerce_Website.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
    string adminName = Model.CurrentAdmin?.admin_name ?? "Administrator";
}

<style>
    :root {
        --dash-primary: #4f46e5;
        --dash-primary-hover: #4338ca;
        --dash-success: #10b981;
        --dash-warning: #f59e0b;
        --dash-info: #0ea5e9;
        --dash-purple: #8b5cf6;
        --dash-dark: #0f172a;
        --dash-muted: #64748b;
        --dash-border: #e2e8f0;
        --dash-bg: #f8fafc;
        --dash-card-bg: #ffffff;
    }

    .admin-dashboard-container {
        padding: 24px 30px;
        background-color: var(--dash-bg);
        min-height: calc(100vh - 70px);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Welcome Header */
    .dashboard-welcome-banner {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);
        border-radius: 16px;
        padding: 28px 32px;
        color: #ffffff;
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        box-shadow: 0 10px 25px -5px rgba(49, 46, 129, 0.25);
    }

    .welcome-text h1 {
        font-size: 1.85rem;
        font-weight: 800;
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
    }

    .welcome-text p {
        font-size: 0.95rem;
        color: #c7d2fe;
        margin: 0;
    }

    .welcome-quick-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-quick-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        font-size: 0.88rem;
        font-weight: 600;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-action-light {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .btn-action-light:hover {
        background: #ffffff;
        color: var(--dash-dark);
        transform: translateY(-1px);
    }

    .btn-action-glow {
        background: #10b981;
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }

    .btn-action-glow:hover {
        background: #059669;
        transform: translateY(-1px);
    }

    /* KPI Metric Cards Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .kpi-card {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.25s ease;
        text-decoration: none;
        color: inherit;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.1);
        border-color: #cbd5e1;
    }

    .kpi-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--dash-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 6px;
    }

    .kpi-value {
        font-size: 1.85rem;
        font-weight: 800;
        color: var(--dash-dark);
        margin-bottom: 4px;
        letter-spacing: -0.02em;
    }

    .kpi-subtext {
        font-size: 0.78rem;
        color: var(--dash-muted);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .kpi-icon-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .kpi-purple .kpi-icon-box { background: #eef2ff; color: #4f46e5; }
    .kpi-green .kpi-icon-box { background: #ecfdf5; color: #10b981; }
    .kpi-blue .kpi-icon-box { background: #f0f9ff; color: #0284c7; }
    .kpi-amber .kpi-icon-box { background: #fffbeb; color: #d97706; }
    .kpi-rose .kpi-icon-box { background: #fff1f2; color: #e11d48; }
    .kpi-cyan .kpi-icon-box { background: #ecfeff; color: #0891b2; }

    /* Main Dashboard Grid */
    .dashboard-two-col {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px;
        margin-bottom: 28px;
    }

    @@media (max-width: 1024px) {
        .dashboard-two-col {
            grid-template-columns: 1fr;
        }
    }

    /* Content Cards */
    .dash-card {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-radius: 14px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .dash-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid var(--dash-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ffffff;
    }

    .dash-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--dash-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dash-card-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--dash-primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: color 0.2s;
    }

    .dash-card-link:hover {
        color: var(--dash-primary-hover);
        text-decoration: underline;
    }

    /* Modern Table */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .dash-table th {
        background: #f8fafc;
        color: var(--dash-muted);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 12px 18px;
        border-bottom: 1px solid var(--dash-border);
    }

    .dash-table td {
        padding: 14px 18px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
        color: #334155;
    }

    .dash-table tr:last-child td {
        border-bottom: none;
    }

    .dash-table tr:hover td {
        background-color: #f8fafc;
    }

    /* Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 9999px;
    }

    .badge-paid {
        background-color: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .badge-cart {
        background-color: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    /* List Item Styles */
    .mini-user-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid #f1f5f9;
    }

    .mini-user-item:last-child {
        border-bottom: none;
    }

    .mini-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mini-user-name {
        font-weight: 600;
        color: var(--dash-dark);
        font-size: 0.9rem;
    }

    .mini-user-sub {
        font-size: 0.78rem;
        color: var(--dash-muted);
    }

    /* Mini Product Item */
    .mini-prod-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        border-bottom: 1px solid #f1f5f9;
    }

    .mini-prod-item:last-child {
        border-bottom: none;
    }

    .mini-prod-img {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    .mini-prod-img img {
        max-width: 100%;
        max-height: 100%;
        object-fit: cover;
    }

    /* Order Status Breakdown Bar */
    .progress-bar-card {
        padding: 20px 22px;
        background: #ffffff;
    }

    .progress-track {
        height: 10px;
        border-radius: 6px;
        background: #f1f5f9;
        display: flex;
        overflow: hidden;
        margin: 12px 0 10px;
    }

    .progress-fill-paid {
        background: #10b981;
        transition: width 0.3s;
    }

    .progress-fill-cart {
        background: #f59e0b;
        transition: width 0.3s;
    }

    /* Quick Shortcuts Bar */
    .shortcuts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-top: 24px;
    }

    .shortcut-card {
        background: #ffffff;
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: var(--dash-dark);
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .shortcut-card:hover {
        border-color: var(--dash-primary);
        color: var(--dash-primary);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.1);
        transform: translateY(-2px);
    }

    .shortcut-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--dash-primary);
        font-size: 1.15rem;
    }
</style>

<div class="admin-dashboard-container">
    <!-- Welcome Header Banner -->
    <div class="dashboard-welcome-banner">
        <div class="welcome-text">
            <h1>Welcome back, @adminName 👋</h1>
            <p>Here is your Molla Gaming &amp; Electronics store performance overview for today, @DateTime.Now.ToString("dd MMMM yyyy").</p>
        </div>
        <div class="welcome-quick-actions">
            <a href="@Url.Action("addProduct", "Admin")" class="btn-quick-action btn-action-glow">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <a href="@Url.Action("addCategory", "Admin")" class="btn-quick-action btn-action-light">
                <i class="fas fa-folder-plus"></i> Add Category
            </a>
            <a href="@Url.Action("Index", "Customer")" target="_blank" class="btn-quick-action btn-action-light">
                <i class="fas fa-external-link-alt"></i> Storefront
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="kpi-grid">
        <!-- Revenue Card -->
        <a href="@Url.Action("fetchCart", "Admin")" class="kpi-card kpi-green">
            <div>
                <div class="kpi-title">Total Sales Revenue</div>
                <div class="kpi-value">₹@Model.TotalRevenue.ToString("N0")</div>
                <div class="kpi-subtext">
                    <span style="color: #059669; font-weight: 700;"><i class="fas fa-arrow-trend-up"></i> Generated</span> from paid orders
                </div>
            </div>
            <div class="kpi-icon-box">
                <i class="fas fa-indian-rupee-sign"></i>
            </div>
        </a>

        <!-- Total Orders Card -->
        <a href="@Url.Action("fetchCart", "Admin")" class="kpi-card kpi-purple">
            <div>
                <div class="kpi-title">Orders &amp; Carts</div>
                <div class="kpi-value">@Model.TotalOrders</div>
                <div class="kpi-subtext">
                    <strong>@Model.CompletedOrders</strong> Paid &bull; <strong>@Model.PendingCarts</strong> Active
                </div>
            </div>
            <div class="kpi-icon-box">
                <i class="fas fa-receipt"></i>
            </div>
        </a>

        <!-- Products Card -->
        <a href="@Url.Action("fetchProduct", "Admin")" class="kpi-card kpi-blue">
            <div>
                <div class="kpi-title">Total Products</div>
                <div class="kpi-value">@Model.TotalProducts</div>
                <div class="kpi-subtext">
                    Across <strong>@Model.TotalCategories</strong> Categories
                </div>
            </div>
            <div class="kpi-icon-box">
                <i class="fas fa-boxes-stacked"></i>
            </div>
        </a>

        <!-- Customers Card -->
        <a href="@Url.Action("fetchCustomer", "Admin")" class="kpi-card kpi-amber">
            <div>
                <div class="kpi-title">Registered Customers</div>
                <div class="kpi-value">@Model.TotalCustomers</div>
                <div class="kpi-subtext">
                    Verified storefront users
                </div>
            </div>
            <div class="kpi-icon-box">
                <i class="fas fa-users"></i>
            </div>
        </a>

        <!-- Feedbacks Card -->
        <a href="@Url.Action("fetchfeedback", "Admin")" class="kpi-card kpi-rose">
            <div>
                <div class="kpi-title">Customer Feedback</div>
                <div class="kpi-value">@Model.TotalFeedbacks</div>
                <div class="kpi-subtext">
                    Feedback inquiries received
                </div>
            </div>
            <div class="kpi-icon-box">
                <i class="fas fa-comments"></i>
            </div>
        </a>
    </div>

    <!-- 2-Column Content Row -->
    <div class="dashboard-two-col">
        <!-- Left: Recent Orders / Carts Table -->
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="fas fa-clock-rotate-left" style="color: var(--dash-primary);"></i>
                    Recent Orders &amp; Cart Items
                </h3>
                <a href="@Url.Action("fetchCart", "Admin")" class="dash-card-link">
                    View All Orders <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <!-- Order Conversion Progress -->
            <div class="progress-bar-card">
                @{
                    int total = Model.TotalOrders > 0 ? Model.TotalOrders : 1;
                    int paidPercent = (Model.CompletedOrders * 100) / total;
                    int cartPercent = (Model.PendingCarts * 100) / total;
                }
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600;">
                    <span><i class="fas fa-circle text-success" style="font-size: 0.6rem; color: #10b981;"></i> Paid Orders (@Model.CompletedOrders)</span>
                    <span><i class="fas fa-circle text-warning" style="font-size: 0.6rem; color: #f59e0b;"></i> In-Cart (@Model.PendingCarts)</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill-paid" style="width: @paidPercent%;"></div>
                    <div class="progress-fill-cart" style="width: @cartPercent%;"></div>
                </div>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Cart ID</th>
                                <th>Customer</th>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Status</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <span style="font-weight: 700; color: #475569;">#@order.cart_id</span>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: #0f172a;">
                                            @(order.customers?.customer_name ?? $"User #{order.cust_id}")
                                        </div>
                                        <small style="color: #64748b;">@(order.customers?.customer_email ?? "")</small>
                                    </td>
                                    <td>
                                        <div style="font-weight: 500; color: #0f172a;">
                                            @(order.products?.product_name ?? $"Product #{order.prod_id}")
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-weight: 700;">@order.product_quantity</span>
                                    </td>
                                    <td>
                                        @if (order.cart_status == 1)
                                        {
                                            <span class="status-badge badge-paid">
                                                <i class="fas fa-check-circle"></i> Paid / Ordered
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-cart">
                                                <i class="fas fa-shopping-bag"></i> In-Cart
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <a href="@Url.Action("updateCart", "Admin", new { id = order.cart_id })" 
                                           class="btn btn-sm btn-outline-primary" 
                                           style="padding: 4px 10px; font-size: 0.8rem; border-radius: 6px; text-decoration: none; border: 1px solid #cbd5e1; color: #334155;">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 40px 20px; color: var(--dash-muted);">
                    <i class="fas fa-inbox fa-3x" style="color: #cbd5e1; margin-bottom: 12px; display: block;"></i>
                    No orders or cart items recorded yet.
                </div>
            }
        </div>

        <!-- Right: Recent Customers & Products Quick Lists -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Recent Customers Card -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">
                        <i class="fas fa-users" style="color: var(--dash-info);"></i>
                        New Customers
                    </h3>
                    <a href="@Url.Action("fetchCustomer", "Admin")" class="dash-card-link">
                        All <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                @if (Model.RecentCustomers.Any())
                {
                    foreach (var cust in Model.RecentCustomers)
                    {
                        string initial = !string.IsNullOrEmpty(cust.customer_name) ? cust.customer_name.Substring(0, 1).ToUpper() : "U";
                        <div class="mini-user-item">
                            <div class="mini-avatar">@initial</div>
                            <div style="flex-grow: 1;">
                                <div class="mini-user-name">@cust.customer_name</div>
                                <div class="mini-user-sub">@(cust.customer_email ?? "No email") &bull; @(cust.customer_city ?? "Store User")</div>
                            </div>
                            <a href="@Url.Action("customerDetails", "Admin", new { id = cust.customer_id })" title="View customer details" style="color: #94a3b8;">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 24px; color: var(--dash-muted); font-size: 0.9rem;">
                        No customers registered yet.
                    </div>
                }
            </div>

            <!-- Recent Products Card -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">
                        <i class="fas fa-box" style="color: var(--dash-purple);"></i>
                        Catalog Products
                    </h3>
                    <a href="@Url.Action("fetchProduct", "Admin")" class="dash-card-link">
                        All <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                @if (Model.RecentProducts.Any())
                {
                    foreach (var prod in Model.RecentProducts)
                    {
                        <div class="mini-prod-item">
                            <div class="mini-prod-img">
                                @if (!string.IsNullOrEmpty(prod.product_image))
                                {
                                    <img src="~/product_images/@prod.product_image" alt="@prod.product_name" />
                                }
                                else
                                {
                                    <i class="fas fa-image" style="color: #cbd5e1;"></i>
                                }
                            </div>
                            <div style="flex-grow: 1;">
                                <div style="font-weight: 600; color: #0f172a; font-size: 0.88rem;">@prod.product_name</div>
                                <div style="font-size: 0.78rem; color: #64748b;">
                                    @(prod.Category?.category_name ?? "General") &bull; <strong style="color: #4f46e5;">₹@prod.product_price</strong>
                                </div>
                            </div>
                            <a href="@Url.Action("productDetails", "Admin", new { id = prod.product_id })" title="View details" style="color: #94a3b8;">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 24px; color: var(--dash-muted); font-size: 0.9rem;">
                        No products created yet.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts Grid -->
    <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--dash-dark); margin: 0 0 14px 0;">Quick Management Navigation</h3>
    <div class="shortcuts-grid">
        <a href="@Url.Action("addProduct", "Admin")" class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-plus"></i></div>
            <div>
                <div>Add Product</div>
                <small style="color: #64748b; font-weight: 400;">New inventory</small>
            </div>
        </a>
        <a href="@Url.Action("fetchCategory", "Admin")" class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-list"></i></div>
            <div>
                <div>Categories</div>
                <small style="color: #64748b; font-weight: 400;">Manage @Model.TotalCategories groups</small>
            </div>
        </a>
        <a href="@Url.Action("fetchCustomer", "Admin")" class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-user-group"></i></div>
            <div>
                <div>Customers</div>
                <small style="color: #64748b; font-weight: 400;">@Model.TotalCustomers users</small>
            </div>
        </a>
        <a href="@Url.Action("fetchCart", "Admin")" class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-receipt"></i></div>
            <div>
                <div>Carts &amp; Orders</div>
                <small style="color: #64748b; font-weight: 400;">Manage orders</small>
            </div>
        </a>
        <a href="@Url.Action("fetchfeedback", "Admin")" class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-comments"></i></div>
            <div>
                <div>Feedback</div>
                <small style="color: #64748b; font-weight: 400;">@Model.TotalFeedbacks messages</small>
            </div>
        </a>
