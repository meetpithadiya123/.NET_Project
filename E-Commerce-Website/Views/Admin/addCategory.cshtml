@model E_Commerce_Website.Models.Category

<div class="page-container">
    <div class="form-panel">
        <div class="form-panel-header">
            <h3>Add New Category</h3>
            <span class="id-badge">New</span>
        </div>

        <form method="post" asp-action="addCategory" asp-controller="Admin" class="form-panel-body">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="input-group-custom">
                    <label asp-for="category_name">Category Name</label>
                    <input type="text" 
                           asp-for="category_name" 
                           class="form-control" 
                           required 
                           placeholder="Enter category name (e.g., Electronics, Fashion)" />
                    <span asp-validation-for="category_name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-panel-footer">
                <a href="@Url.Action("fetchCategory", "Admin")" class="btn btn-cancel">&larr; Back to List</a>
                <button type="submit" class="btn btn-save">Create Category</button>
            </div>
        </form>
    </div>
</div>