@model List<Feedback>

@{
    ViewData["Title"] = "Customer Feedback";
}

<style>
    .feedback-dashboard-wrapper {
        padding: 24px 32px;
        background-color: #f8fafc;
        min-height: calc(100vh - 70px);
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    .page-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .page-header-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .counter-badge {
        font-size: 0.85rem;
        font-weight: 600;
        background-color: #e2e8f0;
        color: #475569;
        padding: 4px 10px;
        border-radius: 9999px;
    }

    .table-container-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .modern-feedback-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .modern-feedback-table thead {
            background: #f1f5f9;
            border-bottom: 1px solid #e2e8f0;
        }

        .modern-feedback-table th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
            color: #64748b;
            padding: 14px 20px;
        }

        .modern-feedback-table td {
            padding: 16px 20px;
            font-size: 0.95rem;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .modern-feedback-table tbody tr:last-child td {
            border-bottom: none;
        }

        .modern-feedback-table tbody tr:hover {
            background-color: #f8fafc;
        }

    .user-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        color: #0f172a;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4338ca;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .message-content {
        color: #475569;
        line-height: 1.5;
        max-width: 550px;
        word-break: break-word;
    }

    .action-button-group {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        border-radius: 6px;
        padding: 7px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease-in-out;
    }

    .btn-delete {
        background-color: #fee2e2;
        color: #dc2626;
    }

        .btn-delete:hover {
            background-color: #fecaca;
            color: #b91c1c;
        }

    .empty-placeholder {
        padding: 48px;
        text-align: center;
        color: #94a3b8;
        font-size: 1rem;
    }
</style>

<div class="feedback-dashboard-wrapper">
    <div class="page-header-row">
        <h1 class="page-header-title">
            Customer Feedback
            <span class="counter-badge">@(Model?.Count ?? 0) Total</span>
        </h1>
    </div>

    <div class="table-container-card">
        @if (Model != null && Model.Any())
        {
            <table class="modern-feedback-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">User</th>
                        <th style="width: 55%;">Message</th>
                        <th style="width: 20%; text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feedback in Model)
                    {
                        <tr>
                            <td>
                                <div class="user-pill">
                                    <div class="user-avatar">
                                        @(string.IsNullOrEmpty(feedback.user_name) ? "?" : feedback.user_name.Substring(0, 1))
                                    </div>
                                    <span>@feedback.user_name</span>
                                </div>
                            </td>
                            <td>
                                <div class="message-content">
                                    @feedback.user_message
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <div class="action-button-group" style="justify-content: flex-end;">
                                    <a href="@Url.Action("deletePermissionFeedback", "Admin", new { id = feedback.feedback_id })"
                                       class="action-btn btn-delete"
                                       onclick="return confirm('Are you sure you want to delete this feedback?');">
                                        <i class="fas fa-trash-alt"></i>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-placeholder">
                <i class="fas fa-inbox fa-2x" style="display: block; margin-bottom: 12px; color: #cbd5e1;"></i>
                No feedback submitted yet.
            </div>
        }
    </div>
</div>