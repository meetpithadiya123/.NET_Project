@model List<E_Commerce_Website.Models.Product>

<h1 class="dashboard-title">All Products</h1>
<div class="row">
    <div class="col-md-12">
        <a href="@Url.Action("addProduct", "Admin")" class="btn btn-primary" style="margin-bottom: 15px; display: inline-block;">Add New Product</a>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var prod in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(prod.product_image))
                                {
                                    <img src="~/product_images/@prod.product_image" alt="@prod.product_name" style="width:60px; height:60px; object-fit:cover; border-radius:6px;" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
                            <td>@prod.product_name</td>
                            <td>@prod.product_price</td>
                            <td>@(prod.Category != null ? prod.Category.category_name : "N/A")</td>
                            <td>@prod.product_description</td>
                            <td>
                                <a href="@Url.Action("productDetails", "Admin", new { id = prod.product_id })" class="btn btn-primary">Details</a>
                                <a href="@Url.Action("updateProduct", "Admin", new { id = prod.product_id })" class="btn btn-warning">Update</a>
                                <a href="@Url.Action("deleteProduct", "Admin", new { id = prod.product_id })" 
                                   class="btn btn-danger" 
                                   onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No products found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="modalOverlay" style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;z-index:99999;">
                <div style="background:#fff;border-radius:10px;padding:28px;width:90%;max-width:380px;box-shadow:0 10px 25px rgba(0,0,0,0.2);font-family:sans-serif;">
                    <h3 style="margin:0 0 10px;font-size:1.4rem;color:#16a34a;font-weight:700;">Success!</h3>
                    <p style="margin:0 0 20px;color:#718096;font-size:0.9rem;line-height:1.5;">@TempData["SuccessMessage"]</p>
                    <button onclick="document.getElementById('modalOverlay').remove()" style="width:100%;padding:10px;background:#16a34a;color:#fff;border:none;border-radius:6px;font-size:0.95rem;font-weight:600;cursor:pointer;">OK</button>
                </div>
            </div>

            <script>
                setTimeout(() => document.getElementById('modalOverlay')?.remove(), 2000);
            </script>
        }
    </div>
</div>