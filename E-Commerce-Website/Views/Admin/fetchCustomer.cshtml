@model List<Customer>
<h1 class="dashboard-title">customer profile</h1><div class="row">
    <div class="col-md-12">
        <table>
            <thead>
                <tr>
                    <th>Sr No.</th>
                    <th>Customer Name</th>
                    <th>Customer Phone</th>
                    <th>Customer Country</th>
                    <th>Customer City</th>
                    <th>Customer Address</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 1;
                }
                @foreach(var cust in Model)
                {

                    <tr>
                        <td>@(count++)</td>
                        <td>@cust.customer_name</td>
                        <td>@cust.customer_phone</td>
                        <td>@cust.customer_city</td>
                        <td>@cust.customer_country</td>
                        <td>@cust.customer_address</td>
                        <td>
                            <a href="@Url.Action("customerDetails","Admin", new{id=cust.customer_id})" class="btn btn-primary">Details</a>
                            <a href="@Url.Action("updateCustomer","Admin", new{id=cust.customer_id})" class="btn btn-info">Update</a>
                            <a href="@Url.Action("deleteCustomer","Admin", new{id=cust.customer_id})" class="btn btn-warning">Delete</a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="modalOverlay" style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;z-index:99999;">
                <div style="background:#fff;border-radius:10px;padding:28px;width:90%;max-width:380px;box-shadow:0 10px 25px rgba(0,0,0,0.2);font-family:sans-serif;">
                    <h3 style="margin:0 0 10px;font-size:1.4rem;color:#2d3748;font-weight:700;">Success!</h3>
                    <p style="margin:0 0 20px;color:#718096;font-size:0.9rem;line-height:1.5;">@TempData["SuccessMessage"]</p>
                    <button onclick="document.getElementById('modalOverlay').remove()" style="width:100%;padding:10px;background:#6366f1;color:#fff;border:none;border-radius:6px;font-size:0.95rem;font-weight:600;cursor:pointer;">OK</button>
                </div>
            </div>

            <script>
                        setTimeout(() => document.getElementById('modalOverlay')?.remove(), 2000);
            </script>
        }
    </div></div>