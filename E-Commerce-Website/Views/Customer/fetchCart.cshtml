@model IEnumerable<E_Commerce_Website.Models.Cart>

@{
    ViewData["Title"] = "Shopping Cart - UrbanCart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal subtotal = 0;
}

<style>
    .cart-page-container {
        max-width: 1200px;
        margin: 35px auto 90px;
        padding: 0 20px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .cart-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #64748b;
        margin-bottom: 24px;
    }

    .cart-breadcrumb a {
        color: #64748b;
        text-decoration: none;
        transition: color 0.2s;
    }

    .cart-breadcrumb a:hover {
        color: #0f172a;
    }

    .cart-header-title {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }

    /* Table Container Styling */
    .cart-table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

    .cart-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    .cart-table td {
        padding: 20px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .cart-table tr:last-child td {
        border-bottom: none;
    }

    /* Product Item Details */
    .cart-product-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .cart-img-box {
        width: 72px;
        height: 72px;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    .cart-img-box img {
        max-width: 100%;
        max-height: 100%;
        object-fit: cover;
    }

    .cart-prod-name {
        font-weight: 700;
        font-size: 0.98rem;
        color: #0f172a;
        margin-bottom: 4px;
        display: block;
    }

    .cart-item-code {
        font-size: 0.78rem;
        color: #94a3b8;
    }

    /* Quantity and Pricing */
    .qty-pill {
        display: inline-block;
        background: #f1f5f9;
        color: #1e293b;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 6px 16px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
    }

    .unit-price {
        font-weight: 600;
        color: #64748b;
    }

    .item-total {
        font-weight: 800;
        color: #0f172a;
        font-size: 1.05rem;
    }

    .btn-remove-item {
        color: #ef4444;
        background: #fee2e2;
        border: none;
        padding: 7px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }

    .btn-remove-item:hover {
        background: #ef4444;
        color: #ffffff;
    }

    /* Summary Card */
    .cart-summary-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.05);
        padding: 26px;
    }

    .summary-title {
        font-weight: 800;
        font-size: 1.25rem;
        color: #0f172a;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 0.95rem;
        color: #64748b;
    }

    .summary-row.total-row {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 2px dashed #e2e8f0;
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
    }

    .btn-checkout-link {
        background: #4f46e5;
        color: #ffffff !important;
        font-size: 1rem;
        font-weight: 700;
        text-align: center;
        display: block;
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        text-decoration: none;
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.35);
        transition: all 0.2s ease;
        margin-top: 20px;
    }

    .btn-checkout-link:hover {
        background: #4338ca;
        transform: translateY(-2px);
    }

    .btn-continue-shopping {
        display: block;
        text-align: center;
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 600;
        margin-top: 14px;
        text-decoration: none;
    }

    .btn-continue-shopping:hover {
        color: #0f172a;
    }

    /* Empty Cart State */
    .empty-cart-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 80px 20px;
        text-align: center;
    }
</style>

<div class="cart-page-container">
    <!-- Breadcrumb -->
    <div class="cart-breadcrumb">
        <a href="@Url.Action("Index", "Customer")"><i class="fas fa-house"></i> Home</a>
        <span>&rsaquo;</span>
        <a href="@Url.Action("allProduct", "Customer")">Products</a>
        <span>&rsaquo;</span>
        <span style="color: #0f172a; font-weight: 600;">Shopping Cart</span>
    </div>

    <h1 class="cart-header-title">Shopping Cart</h1>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Left Side: Items Table -->
            <div class="col-lg-8">
                <div class="cart-table-card">
                    <div class="table-responsive">
                        <table class="cart-table">
                            <thead>
                                <tr>
                                    <th>Product Details</th>
                                    <th>Price</th>
                                    <th class="text-center">Quantity</th>
                                    <th>Total</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    decimal price = 0;
                                    if (item.products != null)
                                    {
                                        decimal.TryParse(Convert.ToString(item.products.product_price), out price);
                                    }

                                    var lineTotal = price * item.product_quantity;
                                    subtotal += lineTotal;

                                    <tr>
                                        <td>
                                            <div class="cart-product-info">
                                                <div class="cart-img-box">
                                                    @if (!string.IsNullOrEmpty(item.products?.product_image))
                                                    {
                                                        <img src="@Url.Content("~/product_images/" + item.products.product_image)" alt="@item.products?.product_name" />
                                                    }
                                                    else
                                                    {
                                                        <img src="https://picsum.photos/seed/@item.prod_id/120/120" alt="No image" />
                                                    }
                                                </div>
                                                <div>
                                                    <span class="cart-prod-name">@(item.products?.product_name ?? $"Item #{item.prod_id}")</span>
                                                    <span class="cart-item-code">ID: #@item.prod_id</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="unit-price">₹@price.ToString("N0")</td>
                                        <td class="text-center">
                                            <span class="qty-pill">@item.product_quantity</span>
                                        </td>
                                        <td class="item-total">₹@lineTotal.ToString("N0")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("deletecart", "Customer", new { id = item.cart_id })" 
                                               onclick="return confirm('Remove this product from your cart?');" 
                                               class="btn-remove-item">
                                                <i class="fas fa-trash-alt"></i> Remove
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="col-lg-4">
                <div class="cart-summary-box">
                    <h2 class="summary-title">Order Summary</h2>

                    <div class="summary-row">
                        <span>Items Subtotal</span>
                        <span class="fw-bold text-dark">₹@subtotal.ToString("N0")</span>
                    </div>

                    <div class="summary-row">
                        <span>Estimated Shipping</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <div class="summary-row">
                        <span>Estimated Taxes</span>
                        <span>₹0</span>
                    </div>

                    <div class="summary-row total-row">
                        <span>Grand Total</span>
                        <span style="color: #4f46e5;">₹@subtotal.ToString("N0")</span>
                    </div>

                    <a href="@Url.Action("Checkout", "Customer")" class="btn-checkout-link">
                        Proceed to Checkout <i class="fas fa-arrow-right ms-2"></i>
                    </a>

                    <a href="@Url.Action("allProduct", "Customer")" class="btn-continue-shopping">
                        <i class="fas fa-arrow-left me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart-card">
            <i class="fas fa-shopping-basket fa-4x text-muted mb-3" style="opacity: 0.4;"></i>
            <h3 class="fw-bold text-dark">Your Cart is Currently Empty</h3>
            <p class="text-muted">Looks like you haven't added any gear to your cart yet.</p>
            <a href="@Url.Action("allProduct", "Customer")" class="btn btn-primary mt-2 px-4 py-2" style="border-radius: 8px;">
                Explore Products
            </a>
        </div>
    }
</div>