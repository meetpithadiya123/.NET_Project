@{
    ViewData["Title"] = "Home - Molla Gaming & Electronics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="top">
    <!-- Hero Section with Categories and Slider -->
    <section class="hero container">
        <aside class="category-card" id="categories">
            <div class="category-title"><i class="fas fa-th-large"></i> CATEGORIES</div>
            <div id="categoryList" class="category-list">
                @await Html.PartialAsync("fetchCategoryList", ViewData["category"])
            </div>
        </aside>

        <section class="hero-main">
            <div class="hero-slider" id="heroSlider">
                <article class="hero-slide active">
                    <img src="/website/images/banner-space.svg" alt="Spacesity 2 sci-fi preorder banner">
                    <div class="slide-copy">
                        <span>PRE-ORDER NOW</span>
                        <h1>SPACESITY 2</h1>
                        <button class="btn-primary" data-scroll="products">PRE-ORDER NOW <i class="fas fa-arrow-right"></i></button>
                    </div>
                </article>
                <article class="hero-slide">
                    <img src="/website/images/banner-neon.svg" alt="Neon gamer weekend offer">
                    <div class="slide-copy">
                        <span>LEVEL UP</span>
                        <h1>NEON LOADOUT</h1>
                        <button class="btn-primary" data-scroll="products">SHOP DEALS <i class="fas fa-arrow-right"></i></button>
                    </div>
                </article>
            </div>
        </section>

        <aside class="hero-side">
            <article class="side-banner">
                <img src="/website/images/side-viva.svg" alt="Viva deal">
                <div>
                    <span>WEEKEND OFFER</span>
                    <strong>VIVAMUS</strong>
                    <button class="buy-btn" data-scroll="products">BUY NOW &rarr;</button>
                </div>
            </article>
            <article class="side-banner">
                <img src="/website/images/side-nesc.svg" alt="Donec deal">
                <div>
                    <span>GAMING DEAL</span>
                    <strong>DONEC NEC</strong>
                    <button class="buy-btn" data-scroll="products">BUY NOW &rarr;</button>
                </div>
            </article>
        </aside>
    </section>

    <!-- Benefits Strip -->
    <section class="benefits container" id="support">
        <div class="benefit"><span class="benefit-icon"><i class="fas fa-truck-fast"></i></span><div><strong>Free Shipping</strong><small>Orders $50 or more</small></div></div>
        <div class="benefit"><span class="benefit-icon"><i class="fas fa-rotate-left"></i></span><div><strong>Free Returns</strong><small>Within 30 days</small></div></div>
        <div class="benefit"><span class="benefit-icon"><i class="fas fa-tags"></i></span><div><strong>Get 20% Off</strong><small>When you sign up</small></div></div>
        <div class="benefit"><span class="benefit-icon"><i class="fas fa-headset"></i></span><div><strong>24/7 Support</strong><small>Live gaming help</small></div></div>
    </section>

    <!-- Products Catalog Section -->
    <section class="product-section container" id="products">
        <div class="section-heading">
            <div>
                <p>CURATED FOR YOU</p>
                <h2>Our Products</h2>
            </div>
            <button class="view-more" id="viewMore">VIEW ALL PRODUCTS &rarr;</button>
        </div>
        <div class="filters" id="filters"></div>
        <div class="products-grid" id="productGrid"></div>
        <div id="emptyState" class="empty-state" style="display:none; text-align:center; padding: 40px; color:#64748b;">No products match your search.</div>
    </section>

    <!-- Promo Banner Section -->
    <section class="promo container" id="about">
        <div class="promo-copy">
            <p>MOLLA CLUB</p>
            <h2>Gear up. Game on.</h2>
            <p>Join our community for weekly drops, exclusive deals and early access to hardware drops.</p>
            <button class="btn-dark" id="signupBtn">JOIN NOW</button>
        </div>
        <img src="/website/images/promo-gamer.svg" alt="Gamer" />
    </section>
</div>