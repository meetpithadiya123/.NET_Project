@model List<Customer>

@{
    ViewData["Title"] = "Customer Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-page-wrapper {
        padding: 50px 20px;
        background: #f8fafc;
        min-height: calc(100vh - 200px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .profile-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        width: 100%;
        max-width: 860px;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        padding: 30px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        border: 2px solid rgba(255, 255, 255, 0.4);
        flex-shrink: 0;
    }

    .profile-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .profile-header p {
        margin: 4px 0 0;
        color: #c7d2fe;
        font-size: 0.95rem;
    }

    .profile-form {
        padding: 35px 30px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px 24px;
    }

    .form-group-full {
        grid-column: span 2;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .form-field label {
            font-size: 0.88rem;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-field label i {
                color: #6366f1;
                font-size: 0.85rem;
            }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.95rem;
            color: #0f172a;
            background: #fdfdfd;
            outline: none;
            transition: all 0.2s ease;
        }

            .input-wrapper input:focus {
                border-color: #4f46e5;
                background: #ffffff;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            }

    .profile-actions {
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .btn-update {
        background: #4f46e5;
        color: #ffffff;
        padding: 12px 30px;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s ease, transform 0.1s ease;
    }

        .btn-update:hover {
            background: #4338ca;
        }

        .btn-update:active {
            transform: scale(0.98);
        }

    .btn-cancel {
        background: #f1f5f9;
        color: #475569;
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: background 0.2s ease;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group-full {
            grid-column: span 1;
        }

        .profile-form {
            padding: 25px 20px;
        }
    }
</style>

<div class="profile-page-wrapper">
    <div class="profile-card">
        <!-- Header banner -->
        <div class="profile-header">
            <div class="profile-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <h2>@(Model != null && Model.Any() ? Model[0].customer_name : "Customer Profile")</h2>
                <p><i class="fas fa-envelope"></i> @(Model != null && Model.Any() ? Model[0].customer_email : "")</p>
            </div>
        </div>

        <!-- Form fields -->
        <form method="post" asp-action="updatecustomerProfile" class="profile-form">
            @Html.AntiForgeryToken()
            @if (Model != null && Model.Any())
            {
                <input type="hidden" name="customer_id" value="@Model[0].customer_id" />

                <div class="form-grid">
                    <!-- Full Name -->
                    <div class="form-field">
                        <label><i class="fas fa-user"></i> Full Name</label>
                        <div class="input-wrapper">
                            <input type="text" name="customer_name" value="@Model[0].customer_name" placeholder="Enter your full name" required />
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="form-field">
                        <label><i class="fas fa-phone"></i> Phone Number</label>
                        <div class="input-wrapper">
                            <input type="tel" name="customer_phone" value="@Model[0].customer_phone" placeholder="Enter your phone number" />
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-field">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <div class="input-wrapper">
                            <input type="email" name="customer_email" value="@Model[0].customer_email" placeholder="Enter your email" required />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="form-field">
                        <label><i class="fas fa-lock"></i> Password</label>
                        <div class="input-wrapper">
                            <input type="password" name="customer_password" value="@Model[0].customer_password" placeholder="Enter password" required />
                        </div>
                    </div>



                    <div class="form-field">
                        <label><i class="fas fa-user-tag"></i> Gender</label>
                        <div class="input-wrapper">
                            <input type="text" name="customer_gender" value="@Model[0].customer_gender" placeholder="Enter Gender" required />
                        </div>
                    </div>


                    <!-- Country -->
                    <div class="form-field">
                        <label><i class="fas fa-globe"></i> Country</label>
                        <div class="input-wrapper">
                            <input type="text" name="customer_country" value="@Model[0].customer_country" placeholder="Enter country" />
                        </div>
                    </div>

                    <!-- City -->
                    <div class="form-field">
                        <label><i class="fas fa-city"></i> City</label>
                        <div class="input-wrapper">
                            <input type="text" name="customer_city" value="@Model[0].customer_city" placeholder="Enter city" />
                        </div>
                    </div>

                    <!-- Full Address -->
                    <div class="form-field form-group-full">
                        <label><i class="fas fa-location-dot"></i> Street Address</label>
                        <div class="input-wrapper">
                            <input type="text" name="customer_address" value="@Model[0].customer_address" placeholder="Enter your complete address" />
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="profile-actions">
                    <a href="@Url.Action("OrderHistory", "Customer")" class="btn-cancel" style="background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-boxes-stacked"></i> My Orders & Purchases
                    </a>
                    <a href="@Url.Action("Index", "Customer")" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 40px; color: #64748b;">
                    <p>No customer details available.</p>
                    <a href="@Url.Action("customerLogin", "Customer")" class="btn-update" style="margin-top: 15px;">Go to Login</a>
                </div>
            }
        </form>
    </div>
</div>