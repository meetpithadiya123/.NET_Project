@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- SweetAlert2 CSS & JS CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .contact-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .contact-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #222;
        margin-bottom: 20px;
    }

    .alert-success-custom {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        padding: 14px 18px;
        border-radius: 4px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 500;
    }

    .contact-wrapper {
        display: flex;
        gap: 35px;
        align-items: stretch;
    }

    .contact-form-box {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .form-input-field {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #e0e0e0;
        border-radius: 2px;
        font-size: 15px;
        color: #333;
        outline: none;
        box-sizing: border-box;
        margin-bottom: 12px;
        background-color: #fafafa;
        transition: border-color 0.2s;
    }

        .form-input-field:focus {
            border-color: #f5a623;
            background-color: #fff;
        }

        .form-input-field::placeholder {
            color: #9e9e9e;
            font-weight: 400;
        }

    .form-textarea {
        flex-grow: 1;
        min-height: 200px;
        resize: vertical;
    }

    .submit-btn {
        width: 100%;
        background-color: #f5a623;
        color: #222;
        font-weight: 600;
        font-size: 16px;
        border: none;
        padding: 14px;
        cursor: pointer;
        border-radius: 2px;
        transition: background-color 0.2s ease;
    }

        .submit-btn:hover {
            background-color: #e0961b;
        }

    .map-box {
        flex: 1;
        min-height: 380px;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid #e0e0e0;
    }

        .map-box iframe {
            width: 100%;
            height: 100%;
            min-height: 380px;
            border: 0;
            display: block;
        }

</style>

<div class="contact-container">
    <h2 class="contact-title">Get In Touch With Us</h2>

    <div class="contact-wrapper">
        <!-- Form Section -->
        <div class="contact-form-box">
            
            <form method="post" asp-controller="Customer" asp-action="feedback">
                <input type="text"
                       class="form-input-field"
                       name="user_name"
                       placeholder="Enter Your Full Name"
                       required />

                <textarea class="form-input-field form-textarea"
                          name="user_message"
                          placeholder="Enter Your Message"
                          rows="7"
                          required></textarea>

                <button type="submit" class="submit-btn">Submit</button>
            </form>
        </div>

        <!-- Google Map Section (Greenland Chowkdi, Rajkot) -->
        <div class="map-box">
            <iframe src="https://maps.google.com/maps?q=Greenland+Chowkdi,+Rajkot,+Gujarat&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </div>
</div>

@if (ViewBag.FeedbackSuccess != null || TempData["FeedbackSuccess"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                title: 'Success!',
                text: '@Html.Raw(ViewBag.FeedbackSuccess ?? TempData["FeedbackSuccess"])',
                icon: 'success',
                confirmButtonColor: '#f5a623',
                confirmButtonText: 'OK'
            });
        });
    </script>
}