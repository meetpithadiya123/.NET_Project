@model E_Commerce_Website.Models.Product

@{
    ViewData["Title"] = Model?.product_name + " - Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .clean-product-page {
        max-width: 1240px;
        margin: 30px auto 80px;
        padding: 0 20px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Minimal Breadcrumb */
    .clean-breadcrumb {
        font-size: 13px;
        color: #71717a;
        margin-bottom: 28px;
    }

    .clean-breadcrumb a {
        color: #71717a;
        text-decoration: none;
    }

    .clean-breadcrumb a:hover {
        color: #09090b;
        text-decoration: underline;
    }

    /* 2-Column Clean Presentation */
    .clean-layout-grid {
        display: grid;
        grid-template-columns: 58% 42%;
        gap: 50px;
        align-items: start;
    }

    /* Large Image Display */
    .big-image-wrapper {
        background: #ffffff;
        border: 1px solid #e4e4e7;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 520px;
    }

    .big-image-wrapper img {
        width: 100%;
        max-height: 500px;
        object-fit: contain;
        border-radius: 8px;
        transition: transform 0.3s ease;
    }

    .big-image-wrapper img:hover {
        transform: scale(1.02);
    }

    /* Info & Action Side */
    .info-action-panel {
        display: flex;
        flex-direction: column;
        padding-top: 10px;
    }

    .clean-title {
        font-size: 32px;
        font-weight: 800;
        color: #18181b;
        line-height: 1.25;
        margin: 0 0 16px 0;
    }

    .clean-price-box {
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #f4f4f5;
    }

    .clean-price {
        font-size: 36px;
        font-weight: 800;
        color: #09090b;
    }

    .clean-description {
        font-size: 15px;
        color: #52525b;
        line-height: 1.7;
        margin: 0 0 32px 0;
    }

    /* Quantity Control */
    .clean-qty-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .clean-qty-row label {
        font-size: 14px;
        font-weight: 600;
        color: #27272a;
    }

    .clean-counter {
        display: inline-flex;
        border: 1px solid #d4d4d8;
        border-radius: 8px;
        overflow: hidden;
    }

    .clean-counter button {
        background: #f4f4f5;
        border: none;
        width: 40px;
        height: 40px;
        cursor: pointer;
        font-size: 18px;
        font-weight: 600;
        color: #27272a;
        transition: background 0.15s;
    }

    .clean-counter button:hover {
        background: #e4e4e7;
    }

    .clean-counter input {
        width: 48px;
        border: none;
        border-left: 1px solid #d4d4d8;
        border-right: 1px solid #d4d4d8;
        text-align: center;
        font-size: 15px;
        font-weight: 600;
        color: #18181b;
        outline: none;
    }

    /* Action Buttons */
    .clean-action-stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .btn-buy-full,
    .btn-cart-full {
        width: 100%;
        height: 52px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease;
    }

    .btn-buy-full {
        background: #f5a623;
        color: #111827;
    }

    .btn-buy-full:hover {
        background: #e0961b;
        box-shadow: 0 4px 14px rgba(245, 166, 35, 0.35);
    }

    .btn-cart-full {
        background: #f4f4f5;
        color: #18181b;
        border: 1px solid #d4d4d8;
    }

    .btn-cart-full:hover {
        background: #e4e4e7;
    }

</style>

<div class="clean-product-page">
    <!-- Breadcrumb Navigation -->
    <div class="clean-breadcrumb">
        <a href="@Url.Action("Index", "Customer")">Home</a>
        <span> / </span>
        <a href="@Url.Action("allProduct", "Customer")">Products</a>
        <span> / </span>
        <span style="color: #18181b; font-weight: 600;">@Model.product_name</span>
    </div>

    <!-- Product Grid -->
    <div class="clean-layout-grid">
        <!-- Big Product Image -->
        <div class="big-image-wrapper">
            @if (!string.IsNullOrEmpty(Model.product_image))
            {
                <img src="~/product_images/@Model.product_image" alt="@Model.product_name" />
            }
            else
            {
                <img src="https://picsum.photos/seed/@Model.product_id/800/600" alt="@Model.product_name" />
            }
        </div>

        <!-- Clean Product Info & Actions -->
        <div class="info-action-panel">
            <h1 class="clean-title">@Model.product_name</h1>

            <div class="clean-price-box">
                <span class="clean-price">₹@Model.product_price</span>
            </div>

            <p class="clean-description">
                @(string.IsNullOrWhiteSpace(Model.product_description)
                    ? "No detailed description available for this product."
                    : Model.product_description)
            </p>

            <!-- Quantity Row -->
            <div class="clean-qty-row">
                <label>Quantity:</label>
                <div class="clean-counter">
                    <button type="button" onclick="updateQty(-1)">&minus;</button>
                    <input type="number" id="buyQty" value="1" min="1" max="10" readonly />
                    <button type="button" onclick="updateQty(1)">&#43;</button>
                </div>
            </div>

            <!-- Buy / Cart Buttons -->
            <div class="clean-action-stack">
                <a href="@Url.Action("Checkout", "Order", new { id = Model.product_id })" class="btn-buy-full">
                    <i class="fas fa-bolt"></i> Buy Now
                </a>

                <form method="post" asp-controller="Customer" asp-action="AddToCart" style="margin: 0; width: 100%;">
                    <input type="hidden" name="productId" value="@Model.product_id" />
                    <input type="hidden" name="quantity" id="hiddenCartQty" value="1" />
                    <button type="button" class="btn-cart-full" onclick="addToCartAjax(@Model.product_id)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function updateQty(change) {
        const input = document.getElementById('buyQty');
        let current = parseInt(input.value) || 1;
        current += change;
        if (current >= 1 && current <= 10) {
            input.value = current;
            document.getElementById('hiddenCartQty').value = current;
        }
    }
</script>