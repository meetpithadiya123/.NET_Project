@model E_Commerce_Website.Models.Product

@{
    ViewData["Title"] = (Model?.product_name ?? "Product Details") + " - UrbanCart";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal price = 0;
    decimal.TryParse(Model?.product_price, out price);
    decimal mrpPrice = price > 0 ? Math.Round(price * 1.15m, 0) : 0;
    decimal savings = mrpPrice - price;
    int discountPercent = mrpPrice > 0 ? (int)Math.Round((savings / mrpPrice) * 100) : 0;

    var relatedProducts = ViewBag.RelatedProducts as List<E_Commerce_Website.Models.Product> ?? new List<E_Commerce_Website.Models.Product>();
}

<style>
    :root {
        --pd-primary: #4f46e5;
        --pd-primary-hover: #4338ca;
        --pd-accent: #f59e0b;
        --pd-accent-hover: #d97706;
        --pd-dark: #0f172a;
        --pd-muted: #64748b;
        --pd-light: #f8fafc;
        --pd-border: #e2e8f0;
        --pd-card-bg: #ffffff;
    }

    .pd-container {
        max-width: 1280px;
        margin: 28px auto 90px;
        padding: 0 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Breadcrumbs */
    .pd-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 0.86rem;
        color: var(--pd-muted);
        margin-bottom: 28px;
    }

    .pd-breadcrumb a {
        color: var(--pd-muted);
        text-decoration: none;
        transition: color 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .pd-breadcrumb a:hover {
        color: var(--pd-primary);
    }

    .pd-breadcrumb span.sep {
        color: #cbd5e1;
    }

    .pd-breadcrumb span.current {
        color: var(--pd-dark);
        font-weight: 600;
        max-width: 380px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Main Showcase Grid */
    .pd-main-grid {
        display: grid;
        grid-template-columns: 52% 48%;
        gap: 46px;
        align-items: start;
        margin-bottom: 60px;
    }

    @@media (max-width: 980px) {
        .pd-main-grid {
            grid-template-columns: 1fr;
            gap: 36px;
        }
    }

    /* Left Column: Media & Gallery */
    .pd-gallery-card {
        background: var(--pd-card-bg);
        border: 1px solid var(--pd-border);
        border-radius: 20px;
        padding: 30px;
        position: relative;
        box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
    }

    .pd-badge-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .pd-badge-genuine {
        background: #ecfdf5;
        color: #059669;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid #a7f3d0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .pd-badge-stock {
        background: #eff6ff;
        color: #2563eb;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid #bfdbfe;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .pd-main-image-wrap {
        width: 100%;
        height: 440px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 14px;
        background: #ffffff;
        cursor: crosshair;
        position: relative;
    }

    .pd-main-image-wrap img {
        max-width: 90%;
        max-height: 400px;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pd-main-image-wrap:hover img {
        transform: scale(1.12);
    }

    /* Thumbnail previews */
    .pd-thumbnails-strip {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        justify-content: center;
    }

    .pd-thumb-btn {
        width: 68px;
        height: 68px;
        border-radius: 10px;
        border: 2px solid var(--pd-border);
        background: #ffffff;
        padding: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pd-thumb-btn.is-active,
    .pd-thumb-btn:hover {
        border-color: var(--pd-primary);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }

    .pd-thumb-btn img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    /* Trust Benefits Bar under Image */
    .pd-trust-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--pd-border);
    }

    .pd-trust-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid #f1f5f9;
    }

    .pd-trust-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #eef2ff;
        color: var(--pd-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .pd-trust-text strong {
        display: block;
        font-size: 0.8rem;
        color: var(--pd-dark);
    }

    .pd-trust-text small {
        font-size: 0.72rem;
        color: var(--pd-muted);
    }

    /* Right Column: Product Info & Buy Engine */
    .pd-details-col {
        display: flex;
        flex-direction: column;
    }

    .pd-category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--pd-primary);
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        padding: 4px 12px;
        border-radius: 9999px;
        margin-bottom: 12px;
        width: fit-content;
    }

    .pd-product-title {
        font-size: 2.1rem;
        font-weight: 800;
        color: var(--pd-dark);
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin: 0 0 14px 0;
    }

    /* Star Rating */
    .pd-rating-strip {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        font-size: 0.88rem;
    }

    .pd-stars {
        color: #f59e0b;
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .pd-rating-number {
        font-weight: 800;
        color: var(--pd-dark);
    }

    .pd-rating-count {
        color: var(--pd-muted);
        font-size: 0.82rem;
    }

    .pd-bestseller-tag {
        background: #fffbeb;
        color: #b45309;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        border: 1px solid #fef3c7;
    }

    /* Price Box */
    .pd-price-card {
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        border: 1.5px solid var(--pd-border);
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 24px;
    }

    .pd-price-main-row {
        display: flex;
        align-items: baseline;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .pd-live-price {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--pd-dark);
        letter-spacing: -0.02em;
    }

    .pd-mrp-price {
        font-size: 1.15rem;
        color: #94a3b8;
        text-decoration: line-through;
        font-weight: 500;
    }

    .pd-discount-badge {
        background: #10b981;
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 8px;
        letter-spacing: 0.02em;
    }

    .pd-tax-note {
        font-size: 0.82rem;
        color: var(--pd-muted);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pd-tax-note i {
        color: #10b981;
    }

    /* Key Feature Highlights */
    .pd-features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 24px;
    }

    .pd-feature-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
    }

    .pd-feature-chip i {
        color: var(--pd-primary);
        font-size: 0.9rem;
    }

    /* Product Description */
    .pd-desc-block {
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.65;
        margin-bottom: 26px;
    }

    /* Purchase Engine Box */
    .pd-purchase-section {
        background: #ffffff;
        border: 1px solid var(--pd-border);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.04);
        margin-bottom: 24px;
    }

    .pd-qty-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }

    .pd-qty-label {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--pd-dark);
    }

    .pd-counter-box {
        display: inline-flex;
        align-items: center;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
    }

    .pd-counter-btn {
        background: #f8fafc;
        border: none;
        width: 42px;
        height: 40px;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--pd-dark);
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pd-counter-btn:hover {
        background: #e2e8f0;
        color: var(--pd-primary);
    }

    .pd-counter-input {
        width: 48px;
        height: 40px;
        border: none;
        border-left: 1.5px solid #cbd5e1;
        border-right: 1.5px solid #cbd5e1;
        text-align: center;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--pd-dark);
        outline: none;
        background: #ffffff;
    }

    /* Dual Action Buttons */
    .pd-buttons-stack {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    @@media (max-width: 540px) {
        .pd-buttons-stack {
            grid-template-columns: 1fr;
        }
    }

    /* Buy Now Button */
    .btn-pd-buy {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 800;
        padding: 15px 20px;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
        text-decoration: none;
    }

    .btn-pd-buy:hover {
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.45);
        color: #ffffff;
    }

    /* Add to Cart Button */
    .btn-pd-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: #0f172a;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 700;
        padding: 15px 20px;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    }

    .btn-pd-cart i {
        color: #38bdf8;
        font-size: 1.1rem;
        transition: transform 0.2s ease;
    }

    .btn-pd-cart:hover {
        background: #4f46e5;
        box-shadow: 0 8px 22px rgba(79, 70, 229, 0.4);
        transform: translateY(-2px);
    }

    .btn-pd-cart:hover i {
        transform: scale(1.15);
        color: #ffffff;
    }

    /* Pincode & Delivery Checker */
    .pd-pincode-box {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .pd-pincode-input-wrap {
        display: flex;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
    }

    .pd-pincode-input-wrap input {
        border: none;
        padding: 8px 12px;
        font-size: 0.85rem;
        outline: none;
        width: 140px;
    }

    .pd-pincode-input-wrap button {
        background: #0f172a;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
    }

    .pd-pincode-input-wrap button:hover {
        background: #4f46e5;
    }

    .pd-delivery-status {
        font-size: 0.82rem;
        color: #059669;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* =========================================
       SPECIFICATIONS & REVIEWS TABS SECTION
       ========================================= */
    .pd-tabs-section {
        background: #ffffff;
        border: 1px solid var(--pd-border);
        border-radius: 20px;
        padding: 34px 38px;
        box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
        margin-bottom: 70px;
    }

    .pd-tabs-nav {
        display: flex;
        gap: 8px;
        border-bottom: 2px solid #f1f5f9;
        margin-bottom: 28px;
        overflow-x: auto;
    }

    .pd-tab-trigger {
        background: none;
        border: none;
        padding: 12px 20px;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--pd-muted);
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .pd-tab-trigger.active {
        color: var(--pd-primary);
    }

    .pd-tab-trigger.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--pd-primary);
        border-radius: 2px;
    }

    .pd-tab-pane {
        display: none;
        animation: pdFadeIn 0.25s ease-out;
    }

    .pd-tab-pane.active {
        display: block;
    }

    @@keyframes pdFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Specs Table */
    .pd-specs-table {
        width: 100%;
        border-collapse: collapse;
    }

    .pd-specs-table tr {
        border-bottom: 1px solid #f1f5f9;
    }

    .pd-specs-table th {
        text-align: left;
        padding: 14px 18px;
        width: 30%;
        font-size: 0.88rem;
        color: #64748b;
        background: #f8fafc;
        font-weight: 600;
    }

    .pd-specs-table td {
        padding: 14px 18px;
        font-size: 0.88rem;
        color: #0f172a;
        font-weight: 500;
    }

    /* Overview Highlights Cards */
    .pd-highlights-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
    }

    .pd-highlight-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 22px;
    }

    .pd-highlight-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #eef2ff;
        color: var(--pd-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 14px;
    }

    .pd-highlight-card h4 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--pd-dark);
        margin: 0 0 6px 0;
    }

    .pd-highlight-card p {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.5;
        margin: 0;
    }

    /* Reviews Layout */
    .pd-reviews-summary {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 36px;
        align-items: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 26px;
        margin-bottom: 28px;
    }

    @@media (max-width: 768px) {
        .pd-reviews-summary {
            grid-template-columns: 1fr;
        }
    }

    .pd-big-rating {
        font-size: 3.5rem;
        font-weight: 900;
        color: var(--pd-dark);
        line-height: 1;
        margin-bottom: 8px;
    }

    .pd-review-bars {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .pd-bar-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.8rem;
        color: #64748b;
    }

    .pd-bar-track {
        flex-grow: 1;
        height: 8px;
        background: #e2e8f0;
        border-radius: 9999px;
        overflow: hidden;
    }

    .pd-bar-fill {
        height: 100%;
        background: #f59e0b;
        border-radius: 9999px;
    }

    .pd-customer-card {
        border-bottom: 1px solid #f1f5f9;
        padding: 18px 0;
    }

    .pd-customer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .pd-customer-user {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pd-customer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e0e7ff;
        color: var(--pd-primary);
        font-weight: 700;
        font-size: 0.82rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* =========================================
       RELATED PRODUCTS GRID & STORE CARDS
       ========================================= */
    .pd-related-section {
        margin-top: 50px;
    }

    .pd-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 26px;
    }

    .pd-section-header h3 {
        font-size: 1.7rem;
        font-weight: 800;
        color: var(--pd-dark);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .pd-related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 26px;
    }

    /* Proper Card Architecture */
    .pd-related-grid .store-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1.5px solid var(--pd-border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 14px -3px rgba(15, 23, 42, 0.04);
        position: relative;
    }

    .pd-related-grid .store-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 34px -8px rgba(15, 23, 42, 0.12);
        border-color: #cbd5e1;
    }

    /* Fixed Image Container with Object-fit Contain */
    .pd-related-grid .store-card-media {
        position: relative;
        width: 100%;
        height: 220px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        border-bottom: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .pd-related-grid .store-card-media img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        transition: transform 0.35s ease;
    }

    .pd-related-grid .store-card:hover .store-card-media img {
        transform: scale(1.06);
    }

    .pd-related-grid .verified-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #ecfdf5;
        color: #059669;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 9999px;
        border: 1px solid #a7f3d0;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        z-index: 2;
    }

    .pd-related-grid .brand-tag-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        text-transform: uppercase;
        z-index: 2;
    }

    .pd-related-grid .store-card-body {
        padding: 18px 20px 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .pd-related-grid .store-rating-bar {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.78rem;
        color: #f59e0b;
        margin-bottom: 8px;
    }

    .pd-related-grid .store-rating-bar span {
        color: var(--pd-muted);
        font-weight: 600;
        font-size: 0.78rem;
        margin-left: 4px;
    }

    .pd-related-grid .store-card-title {
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--pd-dark);
        margin: 0 0 10px 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
